---
import '../styles/global.css';
import '../styles/layout-balance.css';
import CookieConsentBanner from '@/components/CookieConsentBanner';
import PdfGuideOfferPopup from '@/components/PdfGuideOfferPopup';
import WhatsAppCTA from '@/components/WhatsAppCTA';
import SeoShareImage from '@/components/SeoShareImage.astro';
import { SITE_CONFIG } from '@/lib/seo/config';
import { generateOrganizationSchema } from '@/lib/seo/structured-data';

const organizationSchema = JSON.stringify(generateOrganizationSchema()).replace(
  /https:\/\/www\.studenteb5\.com/g,
  SITE_CONFIG.url,
);

interface Props {
  ogImage?: string;
  ogImageAlt?: string;
  fullBleedHero?: boolean;
}

const { ogImage, ogImageAlt, fullBleedHero = false } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<!-- Hold idle work until after the hero paints. Analytics starts on its own timer. -->
		<script is:inline>
			(function () {
				var nativeIdle = window.requestIdleCallback;
				window.requestIdleCallback = function (callback, options) {
					return setTimeout(function () {
						if (typeof nativeIdle === 'function') nativeIdle.call(window, callback, options);
						else callback({ didTimeout: true, timeRemaining: function () { return 0; } });
					}, 800);
				};
			})();
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			window.addEventListener('load', function () {
				var start = function () {
				(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
				new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
				j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
				'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
				})(window,document,'script','dataLayer','GTM-PCXRXQ34');
				var analytics = document.createElement('script');
				analytics.async = true;
				analytics.src = 'https://www.googletagmanager.com/gtag/js?id=G-YWB04H0R4C';
				document.head.appendChild(analytics);
				gtag('js', new Date());
				gtag('config', 'G-YWB04H0R4C');
				var publisher = document.createElement('script');
				publisher.async = true;
				publisher.src = 'https://news.google.com/swg/js/v1/publisher.js';
				document.body.appendChild(publisher);
				};
				setTimeout(start, 1500);
			});
		</script>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="preload" href="/fonts/playfair-display-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/roboto-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
		<SeoShareImage src={ogImage} alt={ogImageAlt} />
		<script type="application/ld+json" set:html={organizationSchema} />
		<slot name="head" />
	</head>
	<body class={fullBleedHero ? 'has-full-bleed-hero' : undefined}>
		<!-- Google Tag Manager (noscript) -->
		<noscript
			><iframe
				src="https://www.googletagmanager.com/ns.html?id=GTM-PCXRXQ34"
				height="0"
				width="0"
				style="display:none;visibility:hidden"></iframe></noscript
		>
		<!-- End Google Tag Manager (noscript) -->
		<slot />
		<WhatsAppCTA />
		<PdfGuideOfferPopup client:idle />
		<CookieConsentBanner client:idle />
	</body>
</html>
