---
import { hasUnsplashCredit, type PhotoRecord } from '@/lib/photos/types';

interface Props {
  photo: PhotoRecord;
}

const { photo } = Astro.props;
---

{
  hasUnsplashCredit(photo) ? (
    <p class="photo-credit">
      Photo by <a href={photo.profileUrl} target="_blank" rel="noopener noreferrer">{photo.photographer}</a> on
      <a href="https://unsplash.com" target="_blank" rel="noopener noreferrer">Unsplash</a>
    </p>
  ) : photo.source === 'supplied' ? (
    <p class="photo-credit">Photograph supplied for this page.</p>
  ) : null
}
