---
/**
 * Compact post-introduction CTA for research articles.
 * Headline uses a styled paragraph (not H2) so TOC / outline stay unchanged.
 */
---

<aside
  data-post-intro-cta
  class="not-prose my-8 rounded-lg border border-border bg-muted/40 px-5 py-5 md:px-6 md:py-5"
  aria-label="Considering EB-5 next step"
>
  <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between md:gap-8">
    <div class="min-w-0 flex-1">
      <p class="font-serif text-lg md:text-xl font-bold text-foreground leading-snug m-0">
        Considering EB-5? See Your Next Step
      </p>
      <p class="text-sm md:text-base text-muted-foreground leading-relaxed mt-1.5 mb-0">
        Explore the EB-5 pathway based on your current U.S. immigration status and goals.
      </p>
    </div>
    <a
      href="/pathways"
      class="inline-flex shrink-0 items-center justify-center rounded-md bg-cta-navy px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-cta-navy/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
    >
      See Your EB-5 Path
    </a>
  </div>
</aside>
