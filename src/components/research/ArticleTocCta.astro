---
import { resolveTocCta } from '@/lib/research/tocCta';
import type { TocCta } from '@/lib/research/tocCta';

interface Props {
  pathwayToc?: TocCta;
  standalone?: boolean;
}

const { pathwayToc, standalone = false } = Astro.props;
const cta = resolveTocCta(pathwayToc);
---

<div
  class:list={[
    'article-contents__cta',
    standalone && 'article-contents__cta--standalone',
  ]}
>
  <a
    href={cta.href}
    class="article-contents__cta-link"
    data-toc-cta
    data-toc-pathway={pathwayToc?.href ?? ''}
  >
    {cta.label}
  </a>
</div>
