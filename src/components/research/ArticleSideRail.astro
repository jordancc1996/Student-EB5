---
import { getImage } from 'astro:assets';
import type { RelatedResearchLink } from '@/lib/research/relatedResearch';
import { DEFAULT_ARTICLE_CONSULTATION } from '@/lib/research/resolveArticlePathway';
import ogFallback from '../../../public/og-image.jpg';

interface Props {
  related: RelatedResearchLink[];
  subheadline?: string;
  buttonLabel?: string;
  buttonHref?: string;
}

const {
  related,
  subheadline = DEFAULT_ARTICLE_CONSULTATION.subheadline,
  buttonLabel = DEFAULT_ARTICLE_CONSULTATION.buttonLabel,
  buttonHref = DEFAULT_ARTICLE_CONSULTATION.href,
} = Astro.props;

const items = await Promise.all(
  related.map(async (item) => {
    const thumb = await getImage({
      src: item.image ?? ogFallback,
      width: 176,
      height: 120,
      format: 'webp',
      fit: 'cover',
      quality: 70,
    });
    return { ...item, thumbSrc: thumb.src };
  }),
);
---

<div class="article-rail-card rounded-lg border border-border bg-card text-card-foreground p-5">
  <p class="font-serif text-lg font-semibold text-foreground m-0 mb-2 leading-snug">Talk to an EB-5 advisor</p>
  <p class="text-sm text-muted-foreground leading-relaxed m-0 mb-4">{subheadline}</p>
  <a
    href={buttonHref}
    class="inline-flex h-11 w-full items-center justify-center gap-2 whitespace-normal rounded-md bg-primary px-8 text-center text-sm font-medium text-primary-foreground ring-offset-background transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
    data-article-rail-cta
  >
    {buttonLabel}
  </a>
</div>

{
  items.length > 0 && (
    <nav class="article-rail-related" aria-label="Related research">
      <p class="article-contents__label">Related research</p>
      <ul class="article-contents__list article-rail-related__list">
        {items.map((item) => (
          <li class="article-rail-related__item">
            <a href={item.href} class="article-contents__link article-rail-related__link">
              <img
                class="article-rail-related__thumb"
                src={item.thumbSrc}
                alt=""
                width="88"
                height="60"
                loading="lazy"
                decoding="async"
              />
              <span class="article-rail-related__copy">
                <span class="article-rail-related__title">{item.title}</span>
                {item.dateTime ? (
                  <time class="article-rail-related__date" datetime={item.dateTime}>
                    {item.date}
                  </time>
                ) : (
                  <span class="article-rail-related__date">{item.date}</span>
                )}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
