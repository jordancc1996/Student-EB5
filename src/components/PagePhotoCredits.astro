---
import { getPhotosUsedOnPath } from '@/data/photoRegistry';
import { hasUnsplashCredit } from '@/lib/photos/types';

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
const photos = getPhotosUsedOnPath(pathname).filter(
  (photo) => hasUnsplashCredit(photo) || photo.source === 'supplied',
);
---

{
  photos.length > 0 && (
    <section class="page-photo-credits" aria-label="Photograph credits">
      <h2 class="page-photo-credits__title">Photograph credits</h2>
      <ul class="page-photo-credits__list">
        {
          photos.map((photo) =>
            hasUnsplashCredit(photo) ? (
              <li>
                Photo by{' '}
                <a href={photo.profileUrl} target="_blank" rel="noopener noreferrer">
                  {photo.photographer}
                </a>{' '}
                on{' '}
                <a href={photo.unsplashUrl} target="_blank" rel="noopener noreferrer">
                  Unsplash
                </a>
                . Used under the Unsplash License.
              </li>
            ) : (
              <li>Photograph supplied for this page. No photographer is named on the file.</li>
            ),
          )
        }
      </ul>
    </section>
  )
}
