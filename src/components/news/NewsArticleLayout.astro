---
import { getCollection } from 'astro:content';
import type { NewsArticleMeta } from '@/data/newsArticles';
import type { TocItem } from '@/lib/research/articleHeadings';
import OptimizedImage from '@/components/OptimizedImage.astro';
import LegalDisclaimer from '@/components/LegalDisclaimer.astro';
import ArticleContents from '@/components/research/ArticleContents.astro';
import ArticleSideRail from '@/components/research/ArticleSideRail.astro';
import ArticleTocRail from '@/components/research/ArticleTocRail.astro';
import { DEFAULT_ARTICLE_CONSULTATION } from '@/lib/research/resolveArticlePathway';
import { selectRelatedResearch } from '@/lib/research/relatedResearch';
import LastUpdated from '@/components/LastUpdated.astro';
import PreferredSourcesCTA from '@/components/PreferredSourcesCTA.astro';
import EditorialPhoto from '@/components/EditorialPhoto.astro';
import PagePhotoCredits from '@/components/PagePhotoCredits.astro';
import ShareButtons from '@/components/ShareButtons';
import RelatedResearchCard from '@/components/RelatedResearchCard.astro';
import { getPlacementsForPath } from '@/data/photoRegistry';
import { SITE_CONFIG } from '@/lib/seo/config';
import { formatDisplayDate } from '@/lib/lastUpdated';

interface Props {
  article: NewsArticleMeta;
  tocItems: TocItem[];
}

const { article, tocItems } = Astro.props;
const lastUpdated = article.dateModified ?? article.datePublished;
const lastUpdatedDisplay = formatDisplayDate(lastUpdated);
const pageCanonical = `${SITE_CONFIG.url}/news/${article.slug}`;
const editorialPhotos = getPlacementsForPath(`/news/${article.slug}`);
const researchPosts = await getCollection('blog');
const relatedPosts = [...researchPosts]
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3)
  .map((post) => post.data);
const railRelated = selectRelatedResearch(
  { href: `/news/${article.slug}`, category: article.category, keywords: article.keywords },
  researchPosts.map((p) => ({
    title: p.data.title,
    href: `/research/${p.data.slug}`,
    date: p.data.date,
    category: p.data.category,
    keywords: p.data.keywords,
    timestamp: new Date(p.data.date).getTime() || 0,
    image: p.data.heroImage,
  })),
);
---

<>
  <section
    class={`relative -mt-[120px] pt-[120px] ${article.heroMinHeightClass} flex items-center overflow-hidden`}
  >
    <OptimizedImage
      src={article.heroImage}
      alt={article.heroImageAlt}
      title={article.title}
      width={article.heroImage.width}
      height={article.heroImage.height}
      className="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      fetchPriority="high"
      sizes="100vw"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/45 to-black/75"></div>
    <div class="relative z-10 w-full py-16 text-white">
      <div class="article-editorial">
        <div class="article-title-block">
      <div class="editorial-kicker mb-5 text-white/80">
        {article.category}
      </div>
      <h1 class="editorial-h1 mb-6 text-white drop-shadow-lg text-left">{article.title}</h1>
      <p class="text-lg md:text-2xl text-white/90 leading-relaxed max-w-3xl mb-8 drop-shadow">
        {article.heroSubtitle}
      </p>
      <div class="research-article-meta flex flex-wrap items-center justify-start gap-6 text-white/90">
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5" aria-hidden="true"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
          <span>Published {article.date}</span>
        </div>
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5" aria-hidden="true"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
          <LastUpdated date={lastUpdated} variant="onDark" as="span" class="!text-base !font-medium !text-white/90" />
        </div>
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>{article.readTime}</span>
        </div>
      </div>
        </div>
      </div>
    </div>
  </section>

  <main class="pt-4 pb-8">
    <div class="article-editorial">
      <ArticleTocRail items={tocItems}>
        <ArticleSideRail
          slot="rail"
          related={railRelated}
          subheadline={DEFAULT_ARTICLE_CONSULTATION.subheadline}
          buttonLabel={DEFAULT_ARTICLE_CONSULTATION.buttonLabel}
        />
        <nav aria-label="Breadcrumb" class="py-4 mb-6">
          <ol class="flex flex-wrap items-center gap-0 text-sm">
            <li class="flex items-center">
              <a href="/" class="text-muted-foreground/70 hover:text-foreground transition-colors font-medium tracking-wide uppercase text-[11px]">
                Home
              </a>
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3 mx-2 text-muted-foreground/30" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </li>
            <li class="flex items-center">
              <a href="/news" class="text-muted-foreground/70 hover:text-foreground transition-colors font-medium tracking-wide uppercase text-[11px]">
                EB-5 News
              </a>
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3 mx-2 text-muted-foreground/30" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </li>
            <li class="flex items-center">
              <span class="text-foreground font-serif text-base font-semibold">{article.breadcrumbLabel}</span>
            </li>
          </ol>
        </nav>

        <div data-article-follow-inline>
          <div data-article-follow>
            <PreferredSourcesCTA />
          </div>
        </div>

        <ArticleContents items={tocItems} />

        <article>
          <LegalDisclaimer className="mb-8 article-legal-disclaimer" />
          <div class="article-content">
            {editorialPhotos[0] && <EditorialPhoto id={editorialPhotos[0].id} layout={editorialPhotos[0].layout} />}
            <slot />
            {editorialPhotos[1] && <EditorialPhoto id={editorialPhotos[1].id} layout={editorialPhotos[1].layout} />}
          </div>
          <PagePhotoCredits pathname={`/news/${article.slug}`} />
          <div class="mt-12">
            <div class="rounded-lg border bg-card text-card-foreground shadow-sm p-8 border-border">
              <h2 class="text-2xl font-serif font-bold mb-4 text-foreground">{article.ctaTitle}</h2>
              <p class="text-muted-foreground mb-6">{article.ctaDescription}</p>
              <a
                href={article.ctaHref}
                class="inline-flex items-center justify-center rounded-full bg-primary px-6 py-3 text-sm font-bold uppercase tracking-[0.18em] text-primary-foreground transition-colors hover:bg-secondary hover:text-secondary-foreground"
              >
                {article.ctaLabel}
              </a>
            </div>
          </div>
        </article>

        <div class="mt-12 p-6 bg-muted/50 border border-border rounded-lg">
          <p class="article-bottom-disclaimer text-muted-foreground leading-relaxed m-0">
            <strong class="text-foreground">Disclaimer:</strong> The opinions expressed on this website are solely those of the author/presenter. The information provided is for general informational purposes only and should not be considered professional or legal advice. Student EB5 and its contributors do not endorse or take responsibility for any actions taken based on the information presented here. Visitors are strongly advised to consult with qualified immigration attorneys and financial advisors before making any EB-5 investment decisions or taking any actions based on the content on this website.
          </p>
        </div>

        <ShareButtons
          client:visible
          url={pageCanonical}
          title={article.title}
          excerpt={article.excerpt}
        />

        <footer class="mt-12 pt-8 border-t">
          <div class="flex items-center justify-between">
            <div class="article-footer-meta text-muted-foreground">
              Published <time datetime={article.datePublished}>{article.date}</time>
              {` · Last updated: ${lastUpdatedDisplay}`}
            </div>
            <a
              href="/contact"
              class="inline-flex items-center px-4 py-2 bg-primary text-primary-foreground rounded-md hover:bg-primary/90 transition-colors"
            >
              Learn More
            </a>
          </div>
        </footer>

        <section class="mt-16 pt-8 border-t">
          <h2 class="editorial-h2 mb-8 mt-0">Related Articles</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {
              relatedPosts.map((relatedPost) => (
                <RelatedResearchCard
                  variant="article"
                  item={{
                    title: relatedPost.title,
                    url: `/research/${relatedPost.slug}`,
                  }}
                  image={relatedPost.image}
                  imageAlt={relatedPost.imageAlt}
                  category={relatedPost.category}
                  date={relatedPost.date}
                  readTime={relatedPost.readTime}
                />
              ))
            }
          </div>
        </section>
      </ArticleTocRail>
    </div>
  </main>
</>
