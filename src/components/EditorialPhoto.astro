---
import PhotoCredit from '@/components/PhotoCredit.astro';
import { getPhoto } from '@/data/photoRegistry';
import { optimizeArticleImage } from '@/lib/images/articleImage';
import { photoAssets } from '@/lib/photos/photoAssets';
import type { PhotoLayout } from '@/lib/photos/types';

interface Props {
  id: string;
  layout?: PhotoLayout;
}

const { id, layout = 'wide' } = Astro.props;
const photo = getPhoto(id);
const asset = photoAssets[id];
const image = photo && asset ? await optimizeArticleImage(asset) : null;
---

{
  photo && image ? (
    <figure class={`article-figure article-figure--${layout}`} data-orientation={image.orientation}>
      <img
        src={image.src}
        srcset={image.srcset}
        sizes={image.sizes}
        width={image.width}
        height={image.height}
        alt={photo.alt}
        loading="lazy"
        decoding="async"
        data-orientation={image.orientation}
      />
      <PhotoCredit photo={photo} />
    </figure>
  ) : null
}
