---
import StatsRow from '@/components/sections/StatsRow.astro';

const stats = [
  { value: "1,000+", label: "Successful EB-5 Petition Approvals", sublabel: "I-526E, I-829 & more" },
  { value: "20+ Years", label: "Combined Industry Experience", sublabel: "At the highest levels of the EB-5 market" },
  { value: "I-956F", label: "USCIS-Certified Regional Centers", sublabel: "Approved & compliant" },
  { value: "$800K", label: "TEA Investment Threshold", sublabel: "Minimum qualifying investment" },
];
---

<section id="partner-credibility" class="py-20 px-8 bg-[hsl(0,0%,97%)]">
  <div class="container mx-auto">
    <h2 class="font-serif font-medium text-3xl md:text-4xl leading-tight max-w-3xl mx-auto text-center mb-8 text-foreground">
      Why StudentEB5?
    </h2>

    <div class="max-w-3xl mx-auto space-y-6 mb-16 text-center">
      <p class="text-muted-foreground font-sans leading-relaxed">
        StudentEB5 explains EB-5 and connects you with EB-5 attorneys and regional centers that have filed many petitions.
      </p>
      <p class="text-muted-foreground font-sans leading-relaxed">
        StudentEB5 connects you with immigration law firms and regional centers that have worked in EB-5 for more than 20 years. Those partners report more than 1,000 EB-5 petition approvals, including I-526E and I-829, for investors from India, China, South Korea, Nigeria, and other countries.
      </p>
      <p class="text-muted-foreground font-sans leading-relaxed">
        Their regional center partners carry <strong class="text-foreground">USCIS I-956F approval</strong>. That approval shows USCIS reviewed compliance and job-creation methods for the project. Choosing an I-956F-approved regional center helps protect capital and the green card timeline.
      </p>
      <p class="text-muted-foreground font-sans leading-relaxed">
        International students and H-1B holders can use this site to reach those attorneys and regional centers.
      </p>
    </div>

    <StatsRow stats={stats} />
  </div>
</section>
