---
import Footer from '@/components/Footer';

const linkClass = 'text-primary-foreground/80 hover:text-accent transition-colors hover:underline';

const columns = [
  {
    title: 'Pathways',
    links: [
      { name: 'Find Your EB-5 Path', href: '/pathways' },
      { name: 'International Students', href: '/pathways/f1-to-eb5-self-sponsored-green-card' },
      { name: 'H-1B Professionals', href: '/pathways/h1b-to-green-card' },
      { name: 'Parents & Families', href: '/pathways/parents-and-families' },
      { name: 'View All Pathways', href: '/pathways/view-all' },
    ],
  },
  {
    title: 'Tools',
    links: [
      { name: 'H-1B Lottery Calculator', href: '/tools/h1b-lottery-odds-calculator' },
      { name: 'H-1B grace period calculator', href: '/research/h1b-60-day-grace-period-layoff-guide' },
      { name: 'Tuition Savings Calculator', href: '/tools/tuition-calculator' },
      { name: 'Grandfathering Countdown', href: '/tools/grandfathering-countdown' },
      { name: 'OPT Calculator', href: '/tools/opt-calculator' },
      { name: 'EB-5 Feasibility Tool', href: '/tools/2026-eb5-investment-feasibility-calculator' },
      { name: 'Source of Funds Calculator', href: '/tools/source-of-funds-calculator' },
      { name: 'Concurrent Filing Checker', href: '/tools/eb5-concurrent-filing-eligibility' },
      { name: 'CSPA Age Calculator', href: '/tools/eb5-cspa-calculator' },
      { name: 'Source of Funds Checklist', href: '/tools/eb5-source-of-funds-checklist' },
      { name: 'Regional Center Scorecard', href: '/tools/eb5-regional-center-scorecard' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { name: 'The F-1 Student Guide', href: '/eb5-green-card-international-students-playbook' },
      { name: 'Student Timeline (Step-by-Step)', href: '/pathways/f1-to-eb5-self-sponsored-green-card' },
      { name: 'The H-1B to EB-5 Guide', href: '/resources' },
      { name: 'H-1B Processing Timeline', href: '/pathways/h1b-to-green-card' },
      { name: 'Source of Funds Strategies', href: '/tools/source-of-funds-calculator' },
      { name: 'EB-5 Processing Times', href: '/eb5-processing-times' },
    ],
  },
];
---

<Footer client:visible>
  {
    columns.map((column) => (
      <div>
        <h4 class="text-lg font-serif font-semibold mb-4">{column.title}</h4>
        <ul class="space-y-2">
          {column.links.map((link) => (
            <li>
              <a href={link.href} class={linkClass}>
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</Footer>
