---
/**
 * Mobile menu markup. An inline script opens it before the Header island hydrates.
 * Desktop dropdowns stay in Header.tsx.
 */
---

<div id="mobile-nav-overlay" hidden data-state="closed" class="fixed inset-0 z-50 bg-black/80 data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0" data-aria-hidden="true" aria-hidden="true" style="pointer-events: auto; display: none;"></div>
<div role="dialog" id="mobile-nav-drawer" hidden aria-labelledby="mobile-nav-title" data-state="closed" class="fixed z-50 gap-4 shadow-lg transition ease-in-out data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:duration-300 data-[state=open]:duration-500 inset-y-0 right-0 h-full border-l data-[state=closed]:slide-out-to-right data-[state=open]:slide-in-from-right sm:max-w-sm w-[88%] max-w-sm p-0 bg-background flex flex-col" tabindex="-1" style="pointer-events: auto; display: none;"><div class="flex flex-col space-y-2 sm:text-left px-6 py-5 border-b border-border/40 text-left"><h2 id="mobile-nav-title" class="text-[15px] uppercase tracking-[0.2em] font-semibold text-foreground">StudentEB5</h2></div><nav class="flex-1 overflow-y-auto px-2 py-4" aria-label="Mobile navigation"><div class="flex flex-col"><a href="/research" class="block px-4 py-4 text-foreground text-[15px] font-medium rounded-md hover:bg-muted/60 transition-colors">Research</a><a href="/news" class="block px-4 py-4 text-foreground text-[15px] font-medium rounded-md hover:bg-muted/60 transition-colors">News</a><a href="/eb5-investment-immigration-tools" class="block px-4 py-4 text-foreground text-[15px] font-medium rounded-md hover:bg-muted/60 transition-colors">Tools</a><a href="/faq" class="block px-4 py-4 text-foreground text-[15px] font-medium rounded-md hover:bg-muted/60 transition-colors">FAQ</a><a href="/about" class="block px-4 py-4 text-foreground text-[15px] font-medium rounded-md hover:bg-muted/60 transition-colors">About</a><a href="/contact" class="block px-4 py-4 text-foreground text-[15px] font-medium rounded-md hover:bg-muted/60 transition-colors">Contact</a><div class="mt-3 pt-3 border-t border-border/40"><span class="px-4 text-[13px] font-medium text-muted-foreground uppercase tracking-wider mb-1 block">Pathways</span><a href="/pathways" class="px-4 py-3 text-foreground text-[14px] rounded-md hover:bg-muted/60 transition-colors flex items-center gap-2.5"><