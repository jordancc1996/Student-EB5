"currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock text-muted-foreground" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg>Grandfathering Countdown</a><a href="/tools/opt-calculator" class="px-4 py-3 text-foreground text-[14px] rounded-md hover:bg-muted/60 transition-colors flex items-center gap-2.5"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar text-muted-foreground" aria-hidden="true"><path d="M8 2v4"></path><path d="M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M3 10h18"></path></svg>OPT Calculator</a><a href="/tools/2026-eb5-investment-feasibility-calculator" class="px-4 py-3 text-foreground text-[14px] rounded-md hover:bg-muted/60 transition-colors flex items-center gap-2.5"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-dollar-sign text-muted-foreground" aria-hidden="true"><line x1="12" x2="12" y1="2" y2="22"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>EB-5 Feasibility Tool</a><a href="/tools/source-of-funds-calculator" class="px-4 py-3 text-foreground text-[14px] rounded-md hover:bg-muted/60 transition-colors flex items-center gap-2.5"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-wallet text-muted-foreground" aria-hidden="true"><path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"></path><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"></path></svg>Source of Funds Calculator</a><a href="/tools/eb5-concurrent-filing-eligibility" class="px-4 py-3 text-foreground text-[14px] rounded-md hover:bg-muted/60 transition-colors flex items-center gap-2.5"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-check text-muted-foreground" aria-hidden="true"><path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"></path><path d="M14 2v5a1 1 0 0 0 1 1h5"></path><path d="m9 15 2 2 4-4"></path></svg>Concurrent Filing Checker</a><a href="/tools/eb5-cspa-calculator" class="px-4 py-3 text-foreground text-[14px] rounded-md hover:bg-muted/60 transition-colors flex items-center gap-2.5"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-baby text-muted-foreground" aria-hidden="true"><path d="M10 16c.5.3 1.2.5 2 .5s1.5-.2 2-.5"></path><path d="M15 12h.01"></path><path d="M19.38 6.813A9 9 0 0 1 20.8 10.2a2 2 0 0 1 0 3.6 9 9 0 0 1-17.6 0 2 2 0 0 1 0-3.6A9 9 0 0 1 12 3c2 0 3.5 1.1 3.5 2.5s-.9 2.5-2 2.5c-.8 0-1.5-.4-1.5-1"></path><path d="M9 12h.01"></path></svg>CSPA Age Calculator</a><a href="/tools/eb5-source-of-funds-checklist" class="px-4 py-3 text-foreground text-[14px] rounded-md hover:bg-muted/60 transition-colors flex items-center gap-2.5"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-list-checks text-muted-foreground" aria-hidden="true"><path d="M13 5h8"></path><path d="M13 12h8"></path><path d="M13 19h8"></path><path d="m3 17 2 2 4-4"></path><path d="m3 7 2 2 4-4"></path></svg>Source of Funds Checklist</a><a href="/tools/eb5-regional-center-scorecard" class="px-4 py-3 text-foreground text-[14px] rounded-md hover:bg-muted/60 transition-colors flex items-center gap-2.5"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-check text-muted-foreground" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg>Regional Center Scorecard</a></div></div></nav><button type="button" class="absolute right-4 top-4 rounded-sm opacity-70 ring-offset-background transition-opacity data-[state=open]:bg-secondary hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 disabled:pointer-events-none"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x h-4 w-4" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg><span class="sr-only">Close</span></button></div>
<script is:inline>
  (function () {
    var open = false;
    var restore = null;
    var hideTimer = 0;

    function parts() {
      return {
        button: document.querySelector('button[aria-controls="mobile-nav-drawer"]'),
        overlay: document.getElementById('mobile-nav-overlay'),
        drawer: document.getElementById('mobile-nav-drawer'),
      };
    }

    function focusable(drawer) {
      return Array.prototype.filter.call(
        drawer.querySelectorAll('a[href], button:not([disabled])'),
        function (el) { return el.getClientRects().length > 0; },
      );
    }

    function setShown(el, shown) {
      el.hidden = !shown;
      el.style.display = shown ? '' : 'none';
    }

    function setChrome(isOpen) {
      var button = parts().button;
      if (!button) return;
      button.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      button.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
      if (isOpen) document.documentElement.setAttribute('data-mobile-nav', 'open');
      else document.documentElement.removeAttribute('data-mobile-nav');
    }

    function watchChrome() {
      if (!open) return;
      setChrome(true);
      window.requestAnimationFrame(watchChrome);
    }

    function show() {
      var ui = parts();
      if (!ui.drawer || !ui.overlay || !ui.button) return;
      window.clearTimeout(hideTimer);
      open = true;
      restore = {
        overflow: document.body.style.overflow,
        pointerEvents: document.body.style.pointerEvents,
      };
      setShown(ui.overlay, true);
      setShown(ui.drawer, true);
      ui.overlay.setAttribute('data-state', 'closed');
      ui.drawer.setAttribute('data-state', 'closed');
      ui.drawer.getBoundingClientRect();
      ui.overlay.setAttribute('data-state', 'open');
      ui.drawer.setAttribute('data-state', 'open');
      document.body.style.overflow = 'hidden';
      document.body.style.pointerEvents = 'none';
      document.body.setAttribute('data-scroll-locked', '1');
      setChrome(true);
      watchChrome();
      var closeButton = ui.drawer.querySelector('button');
      if (closeButton) closeButton.focus();
    }

    function hide() {
      var ui = parts();
      if (!ui.drawer || !ui.overlay) return;
      open = false;
      ui.overlay.setAttribute('data-state', 'closed');
      ui.drawer.setAttribute('data-state', 'closed');
      document.body.style.overflow = restore ? restore.overflow : '';
      document.body.style.pointerEvents = restore ? restore.pointerEvents : '';
      document.body.removeAttribute('data-scroll-locked');
      setChrome(false);
      var button = ui.button;
      hideTimer = window.setTimeout(function () {
        if (open) return;
        setShown(ui.overlay, false);
        setShown(ui.drawer, false);
      }, 300);
      if (button) button.focus();
    }

    document.addEventListener('click', function (event) {
      var target = event.target;
      if (!target || !target.closest) return;
      if (target.closest('button[aria-controls="mobile-nav-drawer"]')) {
        event.preventDefault();
        if (open) hide();
        else show();
        return;
      }
      if (!open) return;
      if (target === document.getElementById('mobile-nav-overlay') || target.closest('#mobile-nav-overlay')) {
        hide();
        return;
      }
      if (target.closest('#mobile-nav-drawer button')) {
        event.preventDefault();
        hide();
        return;
      }
      if (target.closest('#mobile-nav-drawer a[href]')) hide();
    });

    document.addEventListener('keydown', function (event) {
      if (!open) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        hide();
        return;
      }
      if (event.key !== 'Tab') return;
      var drawer = parts().drawer;
      if (!drawer) return;
      var items = focusable(drawer);
      if (!items.length) return;
      var first = items[0];
      var last = items[items.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    document.addEventListener('focusin', function (event) {
      if (!open) return;
      var drawer = parts().drawer;
      if (!drawer || drawer.contains(event.target)) return;
      var closeButton = drawer.querySelector('button');
      if (closeButton) closeButton.focus();
    });

    function park() {
      var ui = parts();
      if (!ui.overlay || !ui.drawer || !document.body) return;
      if (document.body.lastElementChild === ui.drawer) return;
      document.body.appendChild(ui.overlay);
      document.body.appendChild(ui.drawer);
    }

    park();
    new MutationObserver(park).observe(document.body, { childList: true });
    document.documentElement.dataset.mobileNavReady = '1';
  })();
</script>

<style is:global>
  html[data-mobile-nav="open"] nav.nav-simple {
    background-color: hsl(var(--background) / 0.95);
    backdrop-filter: blur(4px);
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
    pointer-events: auto;
  }
  html[data-mobile-nav="open"] nav.nav-simple a,
  html[data-mobile-nav="open"] nav.nav-simple button {
    color: hsl(var(--foreground));
  }
  html[data-mobile-nav="open"] nav.nav-simple a:hover,
  html[data-mobile-nav="open"] nav.nav-simple button:hover {
    color: hsl(var(--foreground) / 0.7);
  }
</style>
