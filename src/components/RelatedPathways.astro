---
import RelatedResearchCard from '@/components/RelatedResearchCard.astro';
import { getRelatedPathways } from '@/lib/relatedPathways';

interface Props {
  pathname: string;
}

const related = getRelatedPathways(Astro.props.pathname);
---

{
  related.length > 0 && (
    <section class="py-16 md:py-20 bg-muted/30 border-t border-border">
      <div class="container mx-auto px-6 max-w-6xl">
        <h2 class="editorial-h2 text-foreground mb-8 text-left mt-0">Related Pathways</h2>
        <div class="layout-grid md:grid md:grid-cols-2 md:gap-6">
          {related.map((page) => (
            <RelatedResearchCard item={{ title: page.title, url: page.url }} />
          ))}
        </div>
      </div>
    </section>
  )
}
