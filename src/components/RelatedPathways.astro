---
import RelatedResearchCard from '@/components/RelatedResearchCard.astro';
import { getRelatedPathwayCards } from '@/lib/relatedPathwayCards';

interface Props {
  pathname: string;
}

const related = await getRelatedPathwayCards(Astro.props.pathname);
---

{
  related.length > 0 && (
    <section class="py-16 md:py-20 bg-muted/30 border-t border-border">
      <div class="container mx-auto px-6 max-w-6xl">
        <h2 class="editorial-h2 text-foreground mb-8 text-left mt-0">Related Pathways</h2>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
          {related.map((page) => (
            <RelatedResearchCard
              item={{ title: page.title, url: page.url }}
              image={page.image}
              imageWebp={page.imageWebp}
              imageAlt={page.imageAlt}
              sizes="(max-width: 768px) 100vw, 25vw"
            />
          ))}
        </div>
      </div>
    </section>
  )
}
