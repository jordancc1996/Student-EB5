---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import PreferredSourcesCTA from '@/components/PreferredSourcesCTA.astro';
import ProcessFaqAccordion from '@/components/ProcessFaqAccordion';
import LastUpdated from '@/components/LastUpdated.astro';
import LegalDisclaimer from '@/components/LegalDisclaimer.astro';
import { SITE_CONFIG } from '@/lib/seo/config';
import { seoTitle } from '@/lib/seo/documentTitle';
import { generateFAQSchema, generateBreadcrumbSchema } from '@/lib/seo/structured-data';
import { getPageLastUpdated } from '@/lib/pageFreshness';
import {
  EB5_RESERVED_SHARE_RURAL,
  EB5_SET_ASIDES_CURRENT,
  EB5_UNRESERVED_FAD_CHINA,
  EB5_UNRESERVED_FAD_INDIA,
  USCIS_RURAL_PRIORITY_SOURCE,
  VISA_BULLETIN_LATEST_MONTH,
  VISA_BULLETIN_SOURCE,
  formatProgramDate,
} from '@/data/program';
import {
  PROCESSING_TIME_DEFINITION,
  PROCESSING_TIMES_AS_OF,
  PROCESSING_TIMES_SOURCE_URL,
  PROCESSING_TIMES_WINDOW,
  formatProcessingMonth,
  formatProcessingMonths,
  processingTimeByForm,
  processingTimes,
} from '@/data/processingTimes';

const i526e = processingTimeByForm('I-526E');
const i526 = processingTimeByForm('I-526');
const i829 = processingTimeByForm('I-829');
const i485 = processingTimeByForm('I-485');
const asOfMonth = formatProcessingMonth(PROCESSING_TIMES_AS_OF);

const title = seoTitle('EB-5 Processing Time: I-526E, I-829 and More');
const description = `EB-5 processing time for ${asOfMonth}: USCIS completed 80% of I-526E cases in ${formatProcessingMonths(i526e.months)} and I-829 cases in ${formatProcessingMonths(i829.months)}.`;
const pageCanonical = `${SITE_CONFIG.url}/eb5-processing-times`;
const lastUpdatedIso = getPageLastUpdated('/eb5-processing-times');
const setAsideSentence = EB5_SET_ASIDES_CURRENT
  ? `In the ${VISA_BULLETIN_LATEST_MONTH} Visa Bulletin, EB-5 rural, high-unemployment, and infrastructure set-asides are current.`
  : `In the ${VISA_BULLETIN_LATEST_MONTH} Visa Bulletin, EB-5 set-asides are not listed as current.`;

const overlapSentence =
  'With concurrent filing, Form I-485 is filed with the I-526E and both are pending at the same time, so these times overlap and should not be added together.';
const i526VisaSentence =
  'USCIS generally first processes Form I-526 for investors for whom a visa is available or will soon be available.';
const ruralPriorityQuote = 'The INA also requires us to prioritize processing petitions for rural areas.';

const timeline = [
  {
    title: 'File Form I-526E',
    timing: formatProcessingMonths(i526e.months),
    text: `Regional center investors file Form I-526E. USCIS completed 80% of those cases in ${formatProcessingMonths(i526e.months)} at the ${i526e.office}.`,
  },
  {
    title: 'I-485 with concurrent filing, or consular processing',
    timing: formatProcessingMonths(i485.months),
    text: `Investors already in the United States can file Form I-485 with the I-526E when a visa number is available. The employment-based I-485 time for EB-5 at ${i485.office} is ${formatProcessingMonths(i485.months)}. Investors abroad use consular processing after petition approval. USCIS does not publish a consular-processing time on this table. Concurrent filing can also include work and travel authorization. See EB-5 concurrent filing.`,
  },
  {
    title: 'Conditional residence',
    timing: 'Two years',
    text: 'Approval leads to a two-year period of conditional permanent residence. That period is the program rule for conditional residence. It is not a USCIS processing-time figure.',
  },
  {
    title: 'File Form I-829',
    timing: formatProcessingMonths(i829.months),
    text: `The investor files Form I-829 to remove conditions. USCIS completed 80% of those cases in ${formatProcessingMonths(i829.months)} at the ${i829.office}.`,
  },
];

const faqs = [
  {
    question: 'How long does EB-5 take?',
    answer: `EB-5 processing time for the I-526E petition is ${formatProcessingMonths(i526e.months)} at the ${i526e.office}. Form I-829 is ${formatProcessingMonths(i829.months)} at the same office. Employment-based Form I-485 for EB-5 is ${formatProcessingMonths(i485.months)} at ${i485.office}. After I-526E approval, conditional residence runs for two years before I-829. These are the times in which USCIS completed 80% of cases from ${PROCESSING_TIMES_WINDOW}. They are not a completion date for one petition. ${overlapSentence}`,
  },
  {
    question: 'How long does I-526E take?',
    answer: `USCIS completed 80% of I-526E cases in ${formatProcessingMonths(i526e.months)} at the ${i526e.office}.`,
  },
  {
    question: 'How long does I-829 take?',
    answer: `USCIS completed 80% of I-829 cases in ${formatProcessingMonths(i829.months)} at the ${i829.office}.`,
  },
  {
    question: 'How long does I-485 take for an EB-5 case?',
    answer: `USCIS completed 80% of employment-based I-485 cases at ${i485.office} in ${formatProcessingMonths(i485.months)}.`,
  },
  {
    question: 'Is rural EB-5 faster?',
    answer: `USCIS publishes one I-526E time, ${formatProcessingMonths(i526e.months)} at the ${i526e.office}. It does not publish a separate rural processing time on the Check Case Processing Times page. Rural projects use a reserved set-aside of ${EB5_RESERVED_SHARE_RURAL}% of EB-5 visas. Unreserved final action dates in that bulletin are ${formatProgramDate(EB5_UNRESERVED_FAD_CHINA)} for China and ${formatProgramDate(EB5_UNRESERVED_FAD_INDIA)} for India. A current set-aside can change when a visa number is available. It does not change the published I-526E time. USCIS states: "${ruralPriorityQuote}"`,
    link: { href: USCIS_RURAL_PRIORITY_SOURCE, text: `"${ruralPriorityQuote}"` },
  },
];

const structuredData = [
  generateFAQSchema(faqs),
  generateBreadcrumbSchema([
    { name: 'Home', url: SITE_CONFIG.url },
    { name: 'EB-5 Processing Time', url: pageCanonical },
  ]),
];
---

<Layout fullBleedHero>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {
      structuredData.map((data) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(data).replace(/https:\/\/www\.studenteb5\.com/g, SITE_CONFIG.url)}
        />
      ))
    }
  </Fragment>

  <div class="min-h-screen bg-background">
    <SiteHeader />

    <main>
      <section class="relative pt-[120px] min-h-[45vh] flex items-center justify-center bg-hero-dark">
        <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/50 to-black/70"></div>
        <div class="relative z-10 container mx-auto px-4 py-20 text-center max-w-4xl">
          <p class="text-white/70 text-xs md:text-sm font-semibold uppercase tracking-[0.18em] mb-4">
            USCIS case processing times
          </p>
          <h1 class="editorial-h1 text-white mb-6">
            EB-5 processing time
          </h1>
          <LastUpdated date={lastUpdatedIso} variant="onDark" class="mb-6" />
          <p class="text-white/85 text-lg md:text-xl max-w-3xl mx-auto leading-relaxed editorial-prose">
            EB-5 processing time for an I-526E regional center petition is {formatProcessingMonths(i526e.months)} at the {i526e.office}. USCIS completed 80% of those cases in that time. Form I-829 is {formatProcessingMonths(i829.months)} at the same office, and employment-based I-485 for EB-5 is {formatProcessingMonths(i485.months)} at {i485.office}.
          </p>
        </div>
      </section>

      <PreferredSourcesCTA />

      <section class="py-16 md:py-20">
        <div class="container mx-auto px-5 max-w-3xl editorial-prose">
          <p class="text-muted-foreground leading-relaxed mb-4">
            Updated {asOfMonth} from USCIS. The figures below are from{' '}
            <a href={PROCESSING_TIMES_SOURCE_URL} target="_blank" rel="noopener noreferrer">Check Case Processing Times</a>.
            USCIS labels the underlying data "{PROCESSING_TIMES_WINDOW}".
          </p>

          <div class="overflow-x-auto mb-6">
            <table class="editorial-table w-full border-collapse">
              <thead>
                <tr>
                  <th class="text-left">Form</th>
                  <th class="text-left">What it is</th>
                  <th class="text-left">Current time</th>
                  <th class="text-left">Office</th>
                </tr>
              </thead>
              <tbody>
                {
                  processingTimes.map((entry) => (
                    <tr>
                      <td>{entry.form}</td>
                      <td>{entry.label}</td>
                      <td>{formatProcessingMonths(entry.months)}</td>
                      <td>{entry.office}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>

          <ul class="space-y-3 mb-4 list-disc pl-5">
            {
              processingTimes.map((entry) => (
                <li class="text-muted-foreground leading-relaxed">
                  <strong class="text-foreground">{entry.form}. </strong>
                  {entry.form === 'I-526' && entry.note.startsWith(i526VisaSentence)
                    ? entry.note.slice(i526VisaSentence.length).trim()
                    : entry.note}
                </li>
              ))
            }
          </ul>
          <p class="text-muted-foreground leading-relaxed">
            Standalone investors file Form I-526 rather than I-526E. That time is {formatProcessingMonths(i526.months)} at the {i526.office}.
          </p>
        </div>
      </section>

      <section class="py-16 md:py-20 bg-muted/30">
        <div class="container mx-auto px-5 max-w-3xl editorial-prose">
          <h2 class="editorial-h2 text-foreground mb-4 mt-0">How USCIS measures this</h2>
          <p class="text-muted-foreground leading-relaxed mb-4">
            USCIS states: "{PROCESSING_TIME_DEFINITION}" Each case can take longer. The published time is a reference point, not a completion date for a single petition.
          </p>
        </div>
      </section>

      <section class="py-16 md:py-20">
        <div class="container mx-auto px-4 max-w-4xl">
          <h2 class="editorial-h2 text-foreground mb-4 text-center mt-0">Total EB-5 timeline</h2>
          <p class="text-muted-foreground text-center mb-12 max-w-2xl mx-auto text-base">
            The stages below use the current table. Concurrent filing and consular processing are different ways to reach conditional residence. {overlapSentence}
          </p>
          <div class="space-y-6">
            {
              timeline.map((step, i) => (
                <div class="flex gap-6">
                  <div class="flex flex-col items-center">
                    <div class="w-10 h-10 bg-primary text-primary-foreground rounded-full flex items-center justify-center font-bold text-sm flex-shrink-0">
                      {i + 1}
                    </div>
                    {i < timeline.length - 1 && <div class="w-px flex-1 bg-border mt-2" />}
                  </div>
                  <div class="pb-8">
                    <p class="text-xs text-primary font-medium uppercase tracking-wider mb-1">{step.timing}</p>
                    <h3 class="editorial-h3 text-foreground mb-2 mt-0">{step.title}</h3>
                    <p class="text-muted-foreground text-sm" style="line-height: 1.75;">
                      {step.text}
                      {
                        i === 1 && (
                          <>
                            {' '}
                            <a href="/pathways/eb5-concurrent-filing" class="text-primary font-medium hover:underline">EB-5 concurrent filing</a>
                            {' '}explains the I-485, work authorization, and travel document package.
                          </>
                        )
                      }
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="py-16 md:py-20 bg-muted/30">
        <div class="container mx-auto px-5 max-w-3xl editorial-prose">
          <h2 class="editorial-h2 text-foreground mb-4 mt-0">What can change your timeline</h2>
          <p class="text-muted-foreground leading-relaxed mb-4">
            {i526VisaSentence}
          </p>
          <p class="text-muted-foreground leading-relaxed mb-4">
            Rural reserved-category projects draw from a set-aside of {EB5_RESERVED_SHARE_RURAL}% of EB-5 visas. <a href="/pathways/rural-eb5">Rural EB-5</a> explains that set-aside. {setAsideSentence} Unreserved final action dates in the {VISA_BULLETIN_LATEST_MONTH} bulletin are {formatProgramDate(EB5_UNRESERVED_FAD_CHINA)} for China and {formatProgramDate(EB5_UNRESERVED_FAD_INDIA)} for India. Source:{' '}<a href={VISA_BULLETIN_SOURCE} target="_blank" rel="noopener noreferrer">Visa Bulletin</a>.
            A current set-aside can change when you may file or finish adjustment of status. It does not replace the I-526E time in the table.
          </p>
        </div>
      </section>

      <section class="py-16 md:py-20" id="faq">
        <div class="container mx-auto px-4 max-w-3xl">
          <h2 class="editorial-h2 text-foreground mb-8 text-center mt-0">
            Frequently Asked Questions
          </h2>
          <ProcessFaqAccordion client:visible items={faqs} />
          <div class="mt-10">
            <LegalDisclaimer />
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </div>
</Layout>
