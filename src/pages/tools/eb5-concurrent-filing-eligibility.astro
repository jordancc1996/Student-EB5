---
import Layout from '../../layouts/Layout.astro';
import Header from '@/components/Header';
import SiteFooter from '@/components/SiteFooter.astro';
import PreferredSourcesCTA from '@/components/PreferredSourcesCTA.astro';
import Breadcrumb from '@/components/Breadcrumb';
import ConcurrentFilingCheckerMainContent from '@/components/ConcurrentFilingCheckerMainContent';
import LastUpdated from '@/components/LastUpdated.astro';
import ToolGuide from '@/components/tools/ToolGuide.astro';
import { toolGuides } from '@/data/toolGuides';
import { getPageLastUpdated } from '@/lib/pageFreshness';
import { SITE_CONFIG } from '@/lib/seo/config';
import { generateFAQSchema, generateWebApplicationSchema } from '@/lib/seo/structured-data';

const title = 'EB-5 Concurrent Filing Checker - I-485 | StudentEB5';
const description =
  'EB-5 concurrent filing eligibility checker shows whether you can file I-526E and I-485 together for EAD and Advance Parole while the petition is pending.';
const pageCanonical = `${SITE_CONFIG.url}/tools/eb5-concurrent-filing-eligibility`;
const keywords = [
  'EB-5 concurrent filing eligibility checker',
  'EB-5 concurrent filing eligibility',
  'Concurrent filing I-485',
  'I-526E',
  'EAD EB-5',
  'Advance Parole EB-5',
];
const lastUpdatedIso = getPageLastUpdated('/tools/eb5-concurrent-filing-eligibility');
---

<Layout fullBleedHero>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <link rel="canonical" href={pageCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(generateWebApplicationSchema({ name: toolGuides.concurrent.h1, url: pageCanonical, description, applicationCategory: toolGuides.concurrent.category }))} />
    <script type="application/ld+json" set:html={JSON.stringify(generateFAQSchema(toolGuides.concurrent.faqs))} />
  </Fragment>

  <div class="min-h-screen bg-background">
    <Header client:load />

    <section class="relative pt-[120px] bg-slate-900">
      <div class="container mx-auto px-4 py-6">
        <Breadcrumb
          client:load
          customTitle="EB-5 Concurrent Filing Eligibility"
          variant="dark"
          initialPathname="/tools/eb5-concurrent-filing-eligibility"
        />
      </div>
    </section>

    <ConcurrentFilingCheckerMainContent client:load>
      <LastUpdated date={lastUpdatedIso} variant="onDark" class="mt-3" />
    </ConcurrentFilingCheckerMainContent>

    <ToolGuide guide={toolGuides.concurrent} />
    <PreferredSourcesCTA />

    <SiteFooter />
  </div>
</Layout>
