---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import PreferredSourcesCTA from '@/components/PreferredSourcesCTA.astro';
import Breadcrumb from '@/components/Breadcrumb';
import RegionalCenterScorecardMainContent from '@/components/RegionalCenterScorecardMainContent';
import LastUpdated from '@/components/LastUpdated.astro';
import ToolGuide from '@/components/tools/ToolGuide.astro';
import { toolGuides } from '@/data/toolGuides';
import { getPageLastUpdated } from '@/lib/pageFreshness';
import { SITE_CONFIG } from '@/lib/seo/config';
import { generateFAQSchema, generateWebApplicationSchema } from '@/lib/seo/structured-data';

const title = 'EB-5 Regional Center Scorecard - Diligence | StudentEB5';
const description =
  'EB-5 regional center scorecard rates track record, I-829 approval history, and compliance data so investors can compare centers before committing capital.';
const pageCanonical = `${SITE_CONFIG.url}/tools/eb5-regional-center-scorecard`;
const keywords = [
  'EB-5 regional center scorecard',
  'regional center due diligence',
  'EB-5 trust score',
  'regional center comparison',
  'EB-5 I-829 approvals',
  'EB-5 SEC compliance',
];
const lastUpdatedIso = getPageLastUpdated('/tools/eb5-regional-center-scorecard');
---

<Layout fullBleedHero>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <link rel="canonical" href={pageCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(generateWebApplicationSchema({ name: toolGuides.scorecard.h1, url: pageCanonical, description, applicationCategory: toolGuides.scorecard.category }))} />
    <script type="application/ld+json" set:html={JSON.stringify(generateFAQSchema(toolGuides.scorecard.faqs))} />
  </Fragment>

  <div class="min-h-screen bg-background">
    <SiteHeader />

    <section class="relative pt-[120px] bg-slate-900">
      <div class="container mx-auto px-4 py-6">
        <Breadcrumb
          client:load
          customTitle="Regional Center Due Diligence Scorecard"
          variant="dark"
          initialPathname="/tools/eb5-regional-center-scorecard"
        />
      </div>
    </section>

    <RegionalCenterScorecardMainContent client:load>
      <LastUpdated date={lastUpdatedIso} variant="onDark" class="mt-3" />
    </RegionalCenterScorecardMainContent>

    <ToolGuide guide={toolGuides.scorecard} />
    <PreferredSourcesCTA />

    <SiteFooter />
  </div>
</Layout>
