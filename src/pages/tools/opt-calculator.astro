---
import Layout from '../../layouts/Layout.astro';
import Header from '@/components/Header';
import SiteFooter from '@/components/SiteFooter.astro';
import PreferredSourcesCTA from '@/components/PreferredSourcesCTA.astro';
import Breadcrumb from '@/components/Breadcrumb';
import OPTCalculatorMainContent from '@/components/OPTCalculatorMainContent';
import LastUpdated from '@/components/LastUpdated.astro';
import ToolGuide from '@/components/tools/ToolGuide.astro';
import { toolGuides } from '@/data/toolGuides';
import { getPageLastUpdated } from '@/lib/pageFreshness';
import { SITE_CONFIG } from '@/lib/seo/config';
import { generateFAQSchema, generateWebApplicationSchema } from '@/lib/seo/structured-data';

const title = 'OPT Calculator - F-1 Dates and EAD Timing | StudentEB5';
const description =
  'OPT calculator maps F-1 application windows, earliest and latest start dates, and EAD work timelines from your program end date under current USCIS rules.';
const pageCanonical = `${SITE_CONFIG.url}/tools/opt-calculator`;
const ogImage = `${SITE_CONFIG.url}/images/opt-calculator-og.jpg`;
const keywords = [
  'OPT calculator',
  'OPT application deadline',
  'F-1 OPT timeline',
  'OPT EAD start date',
];
const lastUpdatedIso = getPageLastUpdated('/tools/opt-calculator');
---

<Layout fullBleedHero ogImage={ogImage}>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <link rel="canonical" href={pageCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(generateWebApplicationSchema({ name: toolGuides.opt.h1, url: pageCanonical, description, applicationCategory: toolGuides.opt.category }))} />
    <script type="application/ld+json" set:html={JSON.stringify(generateFAQSchema(toolGuides.opt.faqs))} />
  </Fragment>

  <Header client:load />

  <section class="relative pt-[120px] bg-slate-900">
    <div class="mx-auto px-10 py-6 max-w-[900px]">
      <Breadcrumb
        client:load
        customTitle="OPT Calculator"
        variant="dark"
        initialPathname="/tools/opt-calculator"
      />
    </div>
  </section>

  <OPTCalculatorMainContent client:load>
    <LastUpdated date={lastUpdatedIso} class="mb-4" />
  </OPTCalculatorMainContent>

  <ToolGuide guide={toolGuides.opt} />
  <PreferredSourcesCTA />

  <SiteFooter />
</Layout>
