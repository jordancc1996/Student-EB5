---
import Layout from '../../layouts/Layout.astro';
import Header from '@/components/Header';
import Footer from '@/components/Footer';
import Breadcrumb from '@/components/Breadcrumb';
import OPTCalculatorMainContent from '@/components/OPTCalculatorMainContent';
import { SITE_CONFIG } from '@/lib/seo/config';

const title = 'OPT Calculator - F-1 Application and EAD Timelines | StudentEB5';
const description =
  'OPT calculator maps F-1 application windows, earliest and latest start dates, and EAD work timelines from your program end date under current USCIS rules.';
const pageCanonical = `${SITE_CONFIG.url}/tools/opt-calculator`;
const ogImage = `${SITE_CONFIG.url}/images/opt-calculator-og.jpg`;
const keywords = [
  'OPT calculator',
  'OPT application deadline',
  'F-1 OPT timeline',
  'OPT EAD start date',
];
---

<Layout>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <link rel="canonical" href={pageCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </Fragment>

  <Header client:load />

  <section class="relative -mt-[120px] pt-[120px] bg-slate-900">
    <div class="mx-auto px-10 py-6 max-w-[900px]">
      <Breadcrumb
        client:load
        customTitle="OPT Calculator"
        variant="dark"
        initialPathname="/tools/opt-calculator"
      />
    </div>
  </section>

  <OPTCalculatorMainContent client:load />

  <Footer client:visible />
</Layout>
