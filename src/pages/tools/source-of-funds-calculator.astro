---
import Layout from '../../layouts/Layout.astro';
import Header from '@/components/Header';
import SiteFooter from '@/components/SiteFooter.astro';
import PreferredSourcesCTA from '@/components/PreferredSourcesCTA.astro';
import Breadcrumb from '@/components/Breadcrumb';
import SourceOfFundsCalculatorMainContent from '@/components/SourceOfFundsCalculatorMainContent';
import LastUpdated from '@/components/LastUpdated.astro';
import { getPageLastUpdated } from '@/lib/pageFreshness';
import { SITE_CONFIG } from '@/lib/seo/config';

const title = 'EB-5 Source of Funds Calculator - Gift, Loan, Crypto | StudentEB5';
const description =
  'EB-5 source of funds calculator models gift, loan, salary, and crypto paths so investors can choose a tax-efficient route to the $800,000 TEA minimum.';
const pageCanonical = `${SITE_CONFIG.url}/tools/source-of-funds-calculator`;
const ogImage = `${SITE_CONFIG.url}/og-image.jpg`;
const keywords = [
  'EB-5 source of funds calculator',
  'EB-5 gifted funds',
  'EB-5 loaned funds',
  'EB-5 crypto source of funds',
  'EB-5 funding paths',
];
const lastUpdatedIso = getPageLastUpdated('/tools/source-of-funds-calculator');
---

<Layout>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <link rel="canonical" href={pageCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </Fragment>

  <div class="min-h-screen bg-gradient-to-b from-background to-muted/20">
    <Header client:load />

    <section class="relative -mt-[120px] pt-[120px] bg-slate-900">
      <div class="container mx-auto px-4 py-6">
        <Breadcrumb
          client:load
          customTitle="Source of Funds Calculator"
          variant="dark"
          initialPathname="/tools/source-of-funds-calculator"
        />
      </div>
    </section>

    <div class="container mx-auto px-4 py-3 max-w-4xl">
      <LastUpdated date={lastUpdatedIso} />
  <PreferredSourcesCTA />
    </div>

    <SourceOfFundsCalculatorMainContent client:load />

    <SiteFooter />
  </div>
</Layout>
