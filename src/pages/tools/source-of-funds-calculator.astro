---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import PreferredSourcesCTA from '@/components/PreferredSourcesCTA.astro';
import Breadcrumb from '@/components/Breadcrumb';
import SourceOfFundsCalculatorMainContent from '@/components/SourceOfFundsCalculatorMainContent';
import LastUpdated from '@/components/LastUpdated.astro';
import ToolGuide from '@/components/tools/ToolGuide.astro';
import { toolGuides } from '@/data/toolGuides';
import { getPageLastUpdated } from '@/lib/pageFreshness';
import { SITE_CONFIG } from '@/lib/seo/config';
import { generateFAQSchema, generateWebApplicationSchema } from '@/lib/seo/structured-data';

const title = 'EB-5 Source of Funds Calculator - Gift or Loan | StudentEB5';
const description =
  'EB-5 source of funds calculator models gift, loan, salary, and crypto paths so investors can choose a tax-efficient route to the $800,000 TEA minimum.';
const pageCanonical = `${SITE_CONFIG.url}/tools/source-of-funds-calculator`;
const keywords = [
  'EB-5 source of funds calculator',
  'EB-5 gifted funds',
  'EB-5 loaned funds',
  'EB-5 crypto source of funds',
  'EB-5 funding paths',
];
const lastUpdatedIso = getPageLastUpdated('/tools/source-of-funds-calculator');
---

<Layout fullBleedHero>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <link rel="canonical" href={pageCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(generateWebApplicationSchema({ name: toolGuides.funds.h1, url: pageCanonical, description, applicationCategory: toolGuides.funds.category }))} />
    <script type="application/ld+json" set:html={JSON.stringify(generateFAQSchema(toolGuides.funds.faqs))} />
  </Fragment>

  <div class="min-h-screen bg-gradient-to-b from-background to-muted/20">
    <SiteHeader />

    <section class="relative pt-[120px] bg-slate-900">
      <div class="container mx-auto px-4 py-2">
        <Breadcrumb
          client:load
          customTitle="Source of Funds Calculator"
          variant="dark"
          initialPathname="/tools/source-of-funds-calculator"
        />
      </div>
    </section>

    <SourceOfFundsCalculatorMainContent client:load>
      <LastUpdated date={lastUpdatedIso} class="mt-3" />
    </SourceOfFundsCalculatorMainContent>

    <ToolGuide guide={toolGuides.funds} />
    <PreferredSourcesCTA />

    <SiteFooter />
  </div>
</Layout>
