---
import Layout from '../../layouts/Layout.astro';
import Header from '@/components/Header';
import SiteFooter from '@/components/SiteFooter.astro';
import PreferredSourcesCTA from '@/components/PreferredSourcesCTA.astro';
import Breadcrumb from '@/components/Breadcrumb';
import TuitionCalculatorMainContent from '@/components/TuitionCalculatorMainContent';
import LastUpdated from '@/components/LastUpdated.astro';
import ToolGuide from '@/components/tools/ToolGuide.astro';
import { toolGuides } from '@/data/toolGuides';
import { getPageLastUpdated } from '@/lib/pageFreshness';
import { SITE_CONFIG } from '@/lib/seo/config';
import { generateFAQSchema, generateWebApplicationSchema } from '@/lib/seo/structured-data';

const title = 'Tuition Savings Calculator - F-1 vs In-State | StudentEB5';
const description =
  'Tuition savings calculator compares F-1 international vs in-state 4-year costs so students can estimate total EB-5 tuition savings before they enroll.';
const pageCanonical = `${SITE_CONFIG.url}/tools/tuition-calculator`;
const ogImage = `${SITE_CONFIG.url}/images/tuition-comparison.png`;
const keywords = [
  'tuition savings calculator',
  'F-1 vs in-state tuition',
  'EB-5 tuition savings',
  'international student tuition calculator',
];
const lastUpdatedIso = getPageLastUpdated('/tools/tuition-calculator');
---

<Layout fullBleedHero ogImage={ogImage}>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <link rel="canonical" href={pageCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(generateWebApplicationSchema({ name: toolGuides.tuition.h1, url: pageCanonical, description, applicationCategory: toolGuides.tuition.category }))} />
    <script type="application/ld+json" set:html={JSON.stringify(generateFAQSchema(toolGuides.tuition.faqs))} />
  </Fragment>

  <div class="min-h-screen bg-gradient-to-br from-background to-secondary/20">
    <Header client:load />

    <section class="relative pt-[120px] bg-slate-900">
      <div class="container mx-auto px-6 py-6">
        <Breadcrumb
          client:load
          customTitle="Tuition Savings Calculator"
          variant="dark"
          initialPathname="/tools/tuition-calculator"
        />
      </div>
    </section>

    <TuitionCalculatorMainContent client:load>
      <LastUpdated date={lastUpdatedIso} class="mt-3" />
    </TuitionCalculatorMainContent>

    <ToolGuide guide={toolGuides.tuition} />
    <PreferredSourcesCTA />

    <SiteFooter />
  </div>
</Layout>
