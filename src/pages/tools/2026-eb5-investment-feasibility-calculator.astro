---
import Layout from '../../layouts/Layout.astro';
import Header from '@/components/Header';
import SiteFooter from '@/components/SiteFooter.astro';
import PreferredSourcesCTA from '@/components/PreferredSourcesCTA.astro';
import Breadcrumb from '@/components/Breadcrumb';
import EB5FeasibilityToolMainContent from '@/components/EB5FeasibilityToolMainContent';
import LastUpdated from '@/components/LastUpdated.astro';
import ToolGuide from '@/components/tools/ToolGuide.astro';
import { toolGuides } from '@/data/toolGuides';
import { getPageLastUpdated } from '@/lib/pageFreshness';
import { SITE_CONFIG } from '@/lib/seo/config';
import {
  NON_TEA_INVESTMENT_THRESHOLD,
  TEA_INVESTMENT_THRESHOLD,
  formatProgramDollars,
} from '@/data/program';
import { generateFAQSchema, generateWebApplicationSchema } from '@/lib/seo/structured-data';

const title = 'EB-5 Feasibility Calculator - TEA Check | StudentEB5';
const description = `EB-5 investment feasibility calculator checks whether liquid assets and gifts can fund the $${formatProgramDollars(TEA_INVESTMENT_THRESHOLD)} TEA or $${formatProgramDollars(NON_TEA_INVESTMENT_THRESHOLD)} standard investment amount.`;
const pageCanonical = `${SITE_CONFIG.url}/tools/2026-eb5-investment-feasibility-calculator`;
const ogImage = `${SITE_CONFIG.url}/images/eb5-feasibility-og.jpg`;
const keywords = [
  'EB-5 investment feasibility calculator',
  'EB-5 feasibility',
  'EB-5 eligibility',
  '$800K TEA investment',
  'EB-5 requirements',
];
const feasibilityPath = '/tools/2026-eb5-investment-feasibility-calculator';
const lastUpdatedIso = getPageLastUpdated(feasibilityPath);
---

<Layout ogImage={ogImage}>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <link rel="canonical" href={pageCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(generateWebApplicationSchema({ name: toolGuides.feasibility.h1, url: pageCanonical, description, applicationCategory: toolGuides.feasibility.category }))} />
    <script type="application/ld+json" set:html={JSON.stringify(generateFAQSchema(toolGuides.feasibility.faqs))} />
  </Fragment>

  <div class="min-h-screen bg-background">
    <Header client:load />

    <section class="relative -mt-[120px] pt-[120px] bg-slate-900 print:hidden">
      <div class="container mx-auto px-4 py-2">
        <Breadcrumb
          client:load
          variant="dark"
          initialPathname={feasibilityPath}
        />
      </div>
    </section>

    <EB5FeasibilityToolMainContent client:load>
      <LastUpdated date={lastUpdatedIso} class="mt-3 print:hidden" />
    </EB5FeasibilityToolMainContent>

    <ToolGuide guide={toolGuides.feasibility} />
    <PreferredSourcesCTA />

    <SiteFooter />
  </div>
</Layout>
