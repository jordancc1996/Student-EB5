---
import Layout from '../../layouts/Layout.astro';
import Header from '@/components/Header';
import SiteFooter from '@/components/SiteFooter.astro';
import PreferredSourcesCTA from '@/components/PreferredSourcesCTA.astro';
import Breadcrumb from '@/components/Breadcrumb';
import SourceOfFundsChecklistMainContent from '@/components/SourceOfFundsChecklistMainContent';
import LastUpdated from '@/components/LastUpdated.astro';
import ToolGuide from '@/components/tools/ToolGuide.astro';
import { toolGuides } from '@/data/toolGuides';
import { getPageLastUpdated } from '@/lib/pageFreshness';
import { SITE_CONFIG } from '@/lib/seo/config';
import { generateFAQSchema, generateWebApplicationSchema } from '@/lib/seo/structured-data';

const title = 'EB-5 Source of Funds Checklist - Documents | StudentEB5';
const description =
  'EB-5 source of funds checklist builds a customized document list for gifts, salary, property sales, and liquidation before you prepare Form I-526E filing.';
const pageCanonical = `${SITE_CONFIG.url}/tools/eb5-source-of-funds-checklist`;
const keywords = [
  'EB-5 source of funds checklist',
  'EB-5 SOF documentation',
  'EB-5 gift documentation',
  'EB-5 property sale source of funds',
  'EB-5 lawful source of funds',
];
const lastUpdatedIso = getPageLastUpdated('/tools/eb5-source-of-funds-checklist');
---

<Layout fullBleedHero>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <link rel="canonical" href={pageCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(generateWebApplicationSchema({ name: toolGuides.checklist.h1, url: pageCanonical, description, applicationCategory: toolGuides.checklist.category }))} />
    <script type="application/ld+json" set:html={JSON.stringify(generateFAQSchema(toolGuides.checklist.faqs))} />
  </Fragment>

  <div class="min-h-screen bg-background">
    <Header client:load />

    <section class="relative pt-[120px] bg-slate-900">
      <div class="container mx-auto px-4 py-6">
        <Breadcrumb
          client:load
          customTitle="EB-5 Source of Funds Checklist"
          variant="dark"
          initialPathname="/tools/eb5-source-of-funds-checklist"
        />
      </div>
    </section>

    <SourceOfFundsChecklistMainContent client:load>
      <LastUpdated date={lastUpdatedIso} variant="onDark" class="mt-3" />
    </SourceOfFundsChecklistMainContent>

    <ToolGuide guide={toolGuides.checklist} />
    <PreferredSourcesCTA />

    <SiteFooter />
  </div>
</Layout>
