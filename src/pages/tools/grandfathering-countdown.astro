---
import Layout from '../../layouts/Layout.astro';
import Header from '@/components/Header';
import SiteFooter from '@/components/SiteFooter.astro';
import PreferredSourcesCTA from '@/components/PreferredSourcesCTA.astro';
import Breadcrumb from '@/components/Breadcrumb';
import GrandfatheringCountdownMainContent from '@/components/GrandfatheringCountdownMainContent';
import LastUpdated from '@/components/LastUpdated.astro';
import ToolGuide from '@/components/tools/ToolGuide.astro';
import { toolGuides } from '@/data/toolGuides';
import { getPageLastUpdated } from '@/lib/pageFreshness';
import { SITE_CONFIG } from '@/lib/seo/config';
import {
  GRANDFATHERING_FILING_DEADLINE,
  RC_PROGRAM_AUTHORIZED_THROUGH,
  formatProgramDate,
} from '@/data/program';
import { generateFAQSchema, generateWebApplicationSchema } from '@/lib/seo/structured-data';

const title = 'EB-5 Grandfathering & 2027 Sunset Countdown';
const description = `The ${formatProgramDate(GRANDFATHERING_FILING_DEADLINE)} grandfathering filing date has passed. This countdown runs to ${formatProgramDate(RC_PROGRAM_AUTHORIZED_THROUGH)}, while the regional center program is authorized.`;
const pageCanonical = `${SITE_CONFIG.url}/tools/grandfathering-countdown`;
const keywords = [
  'EB-5 grandfathering countdown',
  'EB-5 grandfathering deadline',
  'September 30 2026 RIA',
  'I-526E grandfathering',
];
const lastUpdatedIso = getPageLastUpdated('/tools/grandfathering-countdown');
---

<Layout>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <link rel="canonical" href={pageCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(generateWebApplicationSchema({ name: toolGuides.grandfathering.h1, url: pageCanonical, description, applicationCategory: toolGuides.grandfathering.category }))} />
    <script type="application/ld+json" set:html={JSON.stringify(generateFAQSchema(toolGuides.grandfathering.faqs))} />
  </Fragment>

  <Header client:load />

  <section class="relative -mt-[120px] pt-[120px] bg-slate-900">
    <div class="container mx-auto px-6 py-6">
      <Breadcrumb
        client:load
        customTitle="Grandfathering Countdown"
        variant="dark"
        initialPathname="/tools/grandfathering-countdown"
      />
    </div>
  </section>

  <GrandfatheringCountdownMainContent client:load>
    <LastUpdated date={lastUpdatedIso} class="mb-4 text-center" />
  </GrandfatheringCountdownMainContent>

  <ToolGuide guide={toolGuides.grandfathering} />
  <PreferredSourcesCTA />

  <SiteFooter />
</Layout>
