---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import PreferredSourcesCTA from '@/components/PreferredSourcesCTA.astro';
import Breadcrumb from '@/components/Breadcrumb';
import CSPACalculatorMainContent from '@/components/CSPACalculatorMainContent';
import LastUpdated from '@/components/LastUpdated.astro';
import ToolGuide from '@/components/tools/ToolGuide.astro';
import { toolGuides } from '@/data/toolGuides';
import { getPageLastUpdated } from '@/lib/pageFreshness';
import { SITE_CONFIG } from '@/lib/seo/config';
import { generateFAQSchema, generateWebApplicationSchema } from '@/lib/seo/structured-data';

const title = 'EB-5 CSPA Calculator - Child Age-Out Risk | StudentEB5';
const description =
  "EB-5 CSPA age calculator estimates a derivative child's protected age under 2026 USCIS rules so families can gauge age-out risk before filing Form I-526E.";
const pageCanonical = `${SITE_CONFIG.url}/tools/eb5-cspa-calculator`;
const keywords = [
  'EB-5 CSPA age calculator',
  'CSPA age calculator',
  'Child Status Protection Act',
  'EB-5 derivative child age out',
  'CSPA EB-5 2026',
];
const lastUpdatedIso = getPageLastUpdated('/tools/eb5-cspa-calculator');
---

<Layout fullBleedHero>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <link rel="canonical" href={pageCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(generateWebApplicationSchema({ name: toolGuides.cspa.h1, url: pageCanonical, description, applicationCategory: toolGuides.cspa.category }))} />
    <script type="application/ld+json" set:html={JSON.stringify(generateFAQSchema(toolGuides.cspa.faqs))} />
  </Fragment>

  <div class="min-h-screen bg-background">
    <SiteHeader />

    <section class="relative pt-[120px] bg-slate-900">
      <div class="container mx-auto px-4 py-6">
        <Breadcrumb
          client:load
          customTitle="EB-5 CSPA Age Calculator"
          variant="dark"
          initialPathname="/tools/eb5-cspa-calculator"
        />
      </div>
    </section>

    <CSPACalculatorMainContent client:load>
      <LastUpdated date={lastUpdatedIso} variant="onDark" class="mt-3" />
    </CSPACalculatorMainContent>

    <ToolGuide guide={toolGuides.cspa} />
    <PreferredSourcesCTA />

    <SiteFooter />
  </div>
</Layout>
