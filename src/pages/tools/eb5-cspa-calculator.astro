---
import Layout from '../../layouts/Layout.astro';
import Header from '@/components/Header';
import SiteFooter from '@/components/SiteFooter.astro';
import PreferredSourcesCTA from '@/components/PreferredSourcesCTA.astro';
import Breadcrumb from '@/components/Breadcrumb';
import CSPACalculatorMainContent from '@/components/CSPACalculatorMainContent';
import LastUpdated from '@/components/LastUpdated.astro';
import { getPageLastUpdated } from '@/lib/pageFreshness';
import { SITE_CONFIG } from '@/lib/seo/config';

const title = 'EB-5 CSPA Age Calculator - Derivative Child Age-Out Risk | StudentEB5';
const description =
  "EB-5 CSPA age calculator estimates a derivative child's protected age under 2026 USCIS rules so families can gauge age-out risk before filing Form I-526E.";
const pageCanonical = `${SITE_CONFIG.url}/tools/eb5-cspa-calculator`;
const ogImage = `${SITE_CONFIG.url}/og-image.jpg`;
const keywords = [
  'EB-5 CSPA age calculator',
  'CSPA age calculator',
  'Child Status Protection Act',
  'EB-5 derivative child age out',
  'CSPA EB-5 2026',
];
const lastUpdatedIso = getPageLastUpdated('/tools/eb5-cspa-calculator');
---

<Layout>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <link rel="canonical" href={pageCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </Fragment>

  <div class="min-h-screen bg-background">
    <Header client:load />

    <section class="relative -mt-[120px] pt-[120px] bg-slate-900">
      <div class="container mx-auto px-4 py-6">
        <Breadcrumb
          client:load
          customTitle="EB-5 CSPA Age Calculator"
          variant="dark"
          initialPathname="/tools/eb5-cspa-calculator"
        />
      </div>
    </section>

    <div class="container mx-auto px-4 py-3 max-w-4xl">
      <LastUpdated date={lastUpdatedIso} />
  <PreferredSourcesCTA />
    </div>

    <CSPACalculatorMainContent client:load />

    <SiteFooter />
  </div>
</Layout>
