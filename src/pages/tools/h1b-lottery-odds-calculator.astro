---
import Layout from '../../layouts/Layout.astro';
import Header from '@/components/Header';
import SiteFooter from '@/components/SiteFooter.astro';
import PreferredSourcesCTA from '@/components/PreferredSourcesCTA.astro';
import Breadcrumb from '@/components/Breadcrumb';
import H1BLotteryCalculatorMainContent from '@/components/H1BLotteryCalculatorMainContent';
import LastUpdated from '@/components/LastUpdated.astro';
import ToolGuide from '@/components/tools/ToolGuide.astro';
import { toolGuides } from '@/data/toolGuides';
import { getPageLastUpdated } from '@/lib/pageFreshness';
import { generateFAQSchema, generateWebApplicationSchema } from '@/lib/seo/structured-data';
import { Toaster } from '@/components/ui/toaster';
import heroImage from '@/assets/h1b-lottery-hero.jpg';
import { SITE_CONFIG } from '@/lib/seo/config';
import { H1B_WEIGHTED_SELECTION_EFFECTIVE, formatProgramDate } from '@/data/program';

const title = 'Wage-Weighted H-1B Lottery Odds Calculator';
const description =
  "Estimate your H-1B selection odds under the wage-weighted lottery for each of the four wage levels, using this calculator's stated assumptions.";
const pageCanonical = `${SITE_CONFIG.url}/tools/h1b-lottery-odds-calculator`;
const keywords = [
  'H-1B lottery odds calculator',
  'H-1B selection probability',
  'FY 2026 H-1B lottery',
  'H-1B registration model',
];
const lastUpdatedIso = getPageLastUpdated('/tools/h1b-lottery-odds-calculator');
---

<Layout fullBleedHero>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <link rel="canonical" href={pageCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(generateWebApplicationSchema({ name: toolGuides.lottery.h1, url: pageCanonical, description, applicationCategory: toolGuides.lottery.category }))} />
    <script type="application/ld+json" set:html={JSON.stringify(generateFAQSchema(toolGuides.lottery.faqs))} />
  </Fragment>

  <div class="min-h-screen bg-background">
    <Header client:load />

    <section
      class="relative pt-[120px] flex items-center justify-center bg-cover bg-center"
      style={`background-image: url(${heroImage.src})`}
    >
      <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/50 to-black/70" />

      <div class="relative z-10 text-center px-4 py-8">
        <h1 class="editorial-h1 text-white mb-4">
          Wage-Weighted H-1B Lottery Odds Calculator
        </h1>
        <p class="text-white/80 text-lg md:text-xl max-w-2xl mx-auto">
          Estimate your H-1B selection odds under the wage-weighted lottery for each of the four wage levels. The weighted selection rule took effect {formatProgramDate(H1B_WEIGHTED_SELECTION_EFFECTIVE)}.
        </p>
        <LastUpdated date={lastUpdatedIso} variant="onDark" class="mt-3" />
      </div>
    </section>

    <main class="container mx-auto px-4 md:px-8 pt-4 pb-12">
      <Breadcrumb
        client:load
        customTitle="H-1B Lottery Odds Calculator"
        initialPathname="/tools/h1b-lottery-odds-calculator"
      />

      <H1BLotteryCalculatorMainContent client:load />
    </main>

    <ToolGuide guide={toolGuides.lottery} />
    <PreferredSourcesCTA />

    <SiteFooter />
    <Toaster client:load />
  </div>
</Layout>
