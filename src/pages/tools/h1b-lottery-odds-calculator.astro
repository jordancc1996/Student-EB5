---
import Layout from '../../layouts/Layout.astro';
import Header from '@/components/Header';
import SiteFooter from '@/components/SiteFooter.astro';
import PreferredSourcesCTA from '@/components/PreferredSourcesCTA.astro';
import Breadcrumb from '@/components/Breadcrumb';
import H1BLotteryCalculatorMainContent from '@/components/H1BLotteryCalculatorMainContent';
import LastUpdated from '@/components/LastUpdated.astro';
import { getPageLastUpdated } from '@/lib/pageFreshness';
import { Toaster } from '@/components/ui/toaster';
import heroImage from '@/assets/h1b-lottery-hero.jpg';
import { SITE_CONFIG } from '@/lib/seo/config';

const title = 'H-1B Lottery Odds Calculator - 2026 Wage Weighted | StudentEB5';
const description =
  'H-1B lottery odds calculator estimates FY 2026 selection probability by wage tier, country of birth, and registration count under USCIS wage weighting.';
const pageCanonical = `${SITE_CONFIG.url}/tools/h1b-lottery-odds-calculator`;
const ogImage = `${SITE_CONFIG.url}/og-image.jpg`;
const keywords = [
  'H-1B lottery odds calculator',
  'H-1B wage level odds',
  'FY 2026 H-1B lottery',
  'wage-weighted H-1B lottery',
  'H-1B selection probability',
];
const lastUpdatedIso = getPageLastUpdated('/tools/h1b-lottery-odds-calculator');
---

<Layout>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <link rel="canonical" href={pageCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </Fragment>

  <div class="min-h-screen bg-background">
    <Header client:load />

    <section
      class="relative -mt-[120px] pt-[120px] min-h-[50vh] flex items-center justify-center bg-cover bg-center"
      style={`background-image: url(${heroImage.src})`}
    >
      <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/50 to-black/70" />

      <div class="relative z-10 text-center px-4 py-16 md:py-24">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-serif text-white mb-4">
          H-1B Lottery Odds Calculator - 2026 Wage-Weighted Selection Odds
        </h1>
        <p class="text-white/80 text-lg md:text-xl max-w-2xl mx-auto">
          The H-1B lottery odds calculator estimates your FY 2026 selection probability across Wage Levels 1 to 4 based on your SOC code, offered wage, and work location.
        </p>
      </div>
    </section>

    <main class="container mx-auto px-4 md:px-8 pt-4 pb-12">
      <Breadcrumb
        client:load
        customTitle="H-1B Lottery Odds Calculator"
        initialPathname="/tools/h1b-lottery-odds-calculator"
      />

      <div class="py-3">
        <LastUpdated date={lastUpdatedIso} />
  <PreferredSourcesCTA />
      </div>

      <H1BLotteryCalculatorMainContent client:load />
    </main>

    <SiteFooter />
    <Toaster client:load />
  </div>
</Layout>
