---
import Layout from '../layouts/Layout.astro';
import Header from '@/components/Header';
import Footer from '@/components/Footer';
import StudentPlaybookMainContent from '@/components/StudentPlaybookMainContent';
import PlaybookInteractive from '@/components/PlaybookInteractive';
import JourneyCTA from '@/components/JourneyCTA.astro';
import { ConsultationCTA } from '@/components/ConsultationCTA';
import { Toaster } from '@/components/ui/toaster';
import { SITE_CONFIG } from '@/lib/seo/config';
import { generateWebPageSchema } from '@/lib/seo/structured-data';

const title =
  'EB-5 Green Card International Students Playbook - F-1 OPT and STEM Strategy Guide';
const description =
  'EB-5 green card international students playbook covers OPT timelines, STEM OPT extension risks, concurrent filing, and the Sept 30, 2026 grandfathering deadline.';
const pageCanonical = `${SITE_CONFIG.url}/eb5-green-card-international-students-playbook`;
const ogTitle =
  'EB-5 Green Card International Students Playbook - F-1 OPT and STEM Strategy Guide | StudentEB5';
const ogDescription = description;
const ogImage = `${SITE_CONFIG.url}/og-image.jpg`;
const keywords = [
  'EB-5 green card international students playbook',
  'f1 to eb5',
  'STEM OPT EB-5 strategy',
  'avoid h1b lottery through eb5',
  'international student EB-5 guide',
];

const breadcrumbs = [
  { name: 'Home', url: SITE_CONFIG.url },
  { name: 'Resources', url: `${SITE_CONFIG.url}/resources` },
  {
    name: 'EB-5 Green Card International Students Playbook',
    url: `${SITE_CONFIG.url}/eb5-green-card-international-students-playbook`,
  },
];

const structuredData = generateWebPageSchema(
  title,
  description,
  `${SITE_CONFIG.url}/eb5-green-card-international-students-playbook`,
  breadcrumbs
);
---

<Layout>
  <Fragment slot="head">
    <title>{title} | StudentEB5</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <link rel="canonical" href={pageCanonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/https:\/\/www\.studenteb5\.com/g, SITE_CONFIG.url)} />
  </Fragment>

  <div class="min-h-screen bg-background">
    <Header client:load />
    <StudentPlaybookMainContent />
    <PlaybookInteractive client:load />
    <ConsultationCTA client:visible />
    <JourneyCTA />
    <Footer client:visible />
    <Toaster client:load />
  </div>
</Layout>
