---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import PreferredSourcesCTA from '@/components/PreferredSourcesCTA.astro';
import PlaybookInteractive from '@/components/PlaybookInteractive';
import JourneyCTA from '@/components/JourneyCTA.astro';
import { ConsultationCTA } from '@/components/ConsultationCTA';
import { Toaster } from '@/components/ui/toaster';
import { SITE_CONFIG } from '@/lib/seo/config';
import { seoTitle } from '@/lib/seo/documentTitle';
import { generateWebPageSchema } from '@/lib/seo/structured-data';
import { getPageLastUpdated } from '@/lib/pageFreshness';
import StudentPlaybookMainContent from '@/components/StudentPlaybookMainContent';
import { GRANDFATHERING_FILING_DEADLINE, RC_PROGRAM_AUTHORIZED_THROUGH, formatProgramDate } from '@/data/program';

const title =
  'EB-5 Student Playbook - F-1 and OPT | StudentEB5';
const description =
  `EB-5 green card international students playbook covers OPT timelines after ${formatProgramDate(GRANDFATHERING_FILING_DEADLINE)}. The program is authorized through ${formatProgramDate(RC_PROGRAM_AUTHORIZED_THROUGH)}.`;
const pageCanonical = `${SITE_CONFIG.url}/eb5-green-card-international-students-playbook`;
const ogTitle = seoTitle(title);
const ogDescription = description;
const keywords = [
  'EB-5 green card international students playbook',
  'f1 to eb5',
  'STEM OPT EB-5 strategy',
  'avoid h1b lottery through eb5',
  'international student EB-5 guide',
];

const breadcrumbs = [
  { name: 'Home', url: SITE_CONFIG.url },
  { name: 'Resources', url: `${SITE_CONFIG.url}/resources` },
  {
    name: 'EB-5 Green Card International Students Playbook',
    url: `${SITE_CONFIG.url}/eb5-green-card-international-students-playbook`,
  },
];

const lastUpdatedIso = getPageLastUpdated('/eb5-green-card-international-students-playbook');
const structuredData = generateWebPageSchema(
  title,
  description,
  `${SITE_CONFIG.url}/eb5-green-card-international-students-playbook`,
  breadcrumbs,
  lastUpdatedIso,
);
---

<Layout fullBleedHero>
  <Fragment slot="head">
    <title>{ogTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <link rel="canonical" href={pageCanonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/https:\/\/www\.studenteb5\.com/g, SITE_CONFIG.url)} />
  </Fragment>

  <div class="min-h-screen bg-background">
    <SiteHeader />
    <PreferredSourcesCTA />
    <StudentPlaybookMainContent lastUpdatedIso={lastUpdatedIso} />
    <PlaybookInteractive client:load />
    <ConsultationCTA client:visible />
    <JourneyCTA />
    <SiteFooter />
    <Toaster client:load />
  </div>
</Layout>
