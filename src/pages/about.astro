---
import Layout from '../layouts/Layout.astro';
import Header from '@/components/Header';
import Footer from '@/components/Footer';
import Breadcrumb from '@/components/Breadcrumb';
import AboutMainContent from '@/components/AboutMainContent';
import LastUpdated from '@/components/LastUpdated.astro';
import JourneyCTA from '@/components/JourneyCTA.astro';
import { ConsultationCTA } from '@/components/ConsultationCTA';
import { Toaster } from '@/components/ui/toaster';
import OptimizedImage from '@/components/OptimizedImage.astro';
import aboutHeroNew from '@/assets/about-hero-new.jpg';
import aboutHeroNewWebp from '@/assets/about-hero-new.webp';
import { SITE_CONFIG } from '@/lib/seo/config';
import { generateAboutPageSchema } from '@/lib/seo/structured-data';
import { getPageLastUpdated } from '@/lib/pageFreshness';

const title = 'EB-5 Immigration Advisors for F-1 and H-1B';
const description =
  'EB-5 immigration advisors international students use StudentEB5 for F-1 and H-1B green card strategy, $800,000 TEA paths, and Sept 30, 2026 filing timing.';
const pageCanonical = `${SITE_CONFIG.url}/about`;
const ogTitle = `${title} | StudentEB5`;
const ogDescription = description;
const ogImage = `${SITE_CONFIG.url}/og-image.jpg`;
const keywords = [
  'EB-5 immigration advisors international students',
  'EB-5 advisors F-1 students',
  'EB-5 advisors H-1B professionals',
  'permanent residency without sponsorship',
];

const structuredData = generateAboutPageSchema();
const lastUpdatedIso = getPageLastUpdated('/about');
---

<Layout>
  <Fragment slot="head">
    <title>{title} | StudentEB5</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <link rel="canonical" href={pageCanonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/https:\/\/www\.studenteb5\.com/g, SITE_CONFIG.url)} />
  </Fragment>

  <div class="min-h-screen bg-background">
    <Header client:load />

    <section class="relative h-[70vh] min-h-[500px] flex items-center justify-center -mt-[120px] pt-[120px]">
      <div class="absolute inset-0">
        <OptimizedImage
          src={aboutHeroNew}
          webpSrc={aboutHeroNewWebp}
          alt="Golden Gate Bridge tower representing the gateway to American opportunity"
          className="w-full h-full object-cover"
          loading="eager"
          fetchPriority="high"
          sizes="100vw"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-black/30 via-black/40 to-black/60"></div>
      </div>
      <div class="relative z-10 container mx-auto px-6 text-center text-white">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-serif font-bold mb-6 max-w-4xl mx-auto leading-tight">
          EB-5 Immigration Advisors International Students - F-1 and H-1B Guidance
        </h1>
        <p class="text-lg md:text-xl text-white/90 max-w-3xl mx-auto leading-relaxed">
          EB-5 immigration advisors international students trust StudentEB5 to map $800,000 TEA filings, concurrent EAD
          timing, and the Sept 30, 2026 grandfathering window.
        </p>
      </div>
    </section>

    <main class="container mx-auto px-6 pt-4 pb-8">
      <Breadcrumb client:load initialPathname="/about" />
      <LastUpdated date={lastUpdatedIso} class="mb-4 mt-2" />
      <AboutMainContent />
    </main>

    <ConsultationCTA client:visible />
    <JourneyCTA />
    <Footer client:visible />
    <Toaster client:load />
  </div>
</Layout>
