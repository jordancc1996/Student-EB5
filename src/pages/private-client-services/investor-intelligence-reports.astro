---
import Layout from '../../layouts/Layout.astro';
import Header from '@/components/Header';
import Footer from '@/components/Footer';
import Breadcrumb from '@/components/Breadcrumb';
import JourneyCTA from '@/components/JourneyCTA.astro';
import InvestorIntelligenceReportsContent from '@/components/private-client/InvestorIntelligenceReportsContent';
import LastUpdated from '@/components/LastUpdated.astro';
import { ConsultationCTA } from '@/components/ConsultationCTA';
import { Toaster } from '@/components/ui/toaster';
import { SITE_CONFIG } from '@/lib/seo/config';
import { generateWebPageSchema } from '@/lib/seo/structured-data';
import { getPageLastUpdated } from '@/lib/pageFreshness';

const title = 'Investor Intelligence Reports | Private Client Services | StudentEB5';
const description =
  'Independent educational research designed to help prospective EB-5 investors better understand projects and due diligence.';
const pageCanonical = `${SITE_CONFIG.url}/private-client-services/investor-intelligence-reports`;
const ogImage = `${SITE_CONFIG.url}/og-image.jpg`;
const keywords = [
  'EB-5 investor intelligence',
  'EB-5 research reports',
  'investor due diligence',
  'EB-5 project analysis',
  'regional center intelligence',
];

const breadcrumbs = [
  { name: 'Home', url: SITE_CONFIG.url },
  { name: 'Private Client Services', url: `${SITE_CONFIG.url}/private-client-services` },
  { name: 'Investor Intelligence Reports', url: pageCanonical },
];

const lastUpdatedIso = getPageLastUpdated('/private-client-services/investor-intelligence-reports');
const structuredData = generateWebPageSchema(
  'Investor Intelligence Reports',
  description,
  pageCanonical,
  breadcrumbs,
  lastUpdatedIso,
);
---

<Layout>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <link rel="canonical" href={pageCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/https:\/\/www\.studenteb5\.com/g, SITE_CONFIG.url)} />
  </Fragment>

  <div class="min-h-screen bg-gradient-to-br from-background to-secondary/20">
    <Header client:load />

    <main class="container mx-auto px-6 py-8">
      <Breadcrumb client:load initialPathname="/private-client-services/investor-intelligence-reports" />
      <LastUpdated date={lastUpdatedIso} class="mb-4 mt-2" />
      <InvestorIntelligenceReportsContent />
    </main>

    <ConsultationCTA client:visible />
    <JourneyCTA />
    <Footer client:visible />
    <Toaster client:load />
  </div>
</Layout>
