---
import Layout from '../../layouts/Layout.astro';
import Header from '@/components/Header';
import Footer from '@/components/Footer';
import StatsRow from '@/components/sections/StatsRow.astro';
import LastUpdated from '@/components/LastUpdated.astro';
import { Card, CardContent, CardHeader } from '@/components/ui/card';
import { SITE_CONFIG } from '@/lib/seo/config';
import { generateWebPageSchema } from '@/lib/seo/structured-data';
import { getPageLastUpdated } from '@/lib/pageFreshness';

const title = 'Private Client Services | StudentEB5';
const description =
  'Independent research, personalized guidance, and premium educational resources for investors navigating the EB-5 process.';
const pageCanonical = `${SITE_CONFIG.url}/private-client-services`;
const ogImage = `${SITE_CONFIG.url}/og-image.jpg`;
const keywords = [
  'private client services',
  'EB-5 investor advisory',
  'investor intelligence reports',
  'EB-5 strategy sessions',
  'EB-5 resource library',
];

const breadcrumbs = [
  { name: 'Home', url: SITE_CONFIG.url },
  { name: 'Private Client Services', url: pageCanonical },
];

const lastUpdatedIso = getPageLastUpdated('/private-client-services');
const structuredData = generateWebPageSchema(
  'Private Client Services',
  description,
  pageCanonical,
  breadcrumbs,
  lastUpdatedIso,
);

const primaryService = {
  href: '/private-client-services/private-strategy-sessions',
  numeral: '01',
  title: 'Private Strategy Sessions',
  description:
    'One-on-one educational consultations designed to help prospective EB-5 investors organize their planning before engaging legal and financial professionals.',
  cta: 'Explore Sessions →',
};

const secondaryServices = [
  {
    href: '/private-client-services/investor-intelligence-reports',
    numeral: '02',
    title: 'Investor Intelligence Reports',
    description:
      'Independent educational research on projects, regional centers, offering structures, and due diligence considerations.',
    cta: 'View Reports →',
  },
  {
    href: '/private-client-services/investor-resource-library',
    numeral: '03',
    title: 'Investor Resource Library',
    description:
      'Download professional planning resources, guides, worksheets, and educational tools created specifically for EB-5 investors.',
    cta: 'Browse Library →',
  },
];

// TODO: Replace placeholder PCS stats with real Private Client Services metrics
// once confirmed by the client. Do not invent or publish unverified figures.
const privateClientStats = [
  { value: '—', label: 'Stat pending', sublabel: 'TODO: confirm value' },
  { value: '—', label: 'Stat pending', sublabel: 'TODO: confirm value' },
  { value: '—', label: 'Stat pending', sublabel: 'TODO: confirm value' },
  { value: '—', label: 'Stat pending', sublabel: 'TODO: confirm value' },
];
---

<Layout>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <link rel="canonical" href={pageCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/https:\/\/www\.studenteb5\.com/g, SITE_CONFIG.url)} />
  </Fragment>

  <div class="min-h-screen bg-background">
    <Header client:load />

    <main>
      <section class="relative -mt-[120px] pt-[120px] min-h-[50vh] flex items-center justify-center bg-hero-dark">
        <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/50 to-black/70"></div>
        <div class="relative z-10 container mx-auto px-4 py-20 text-center">
          <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
            Private Client Services
          </h1>
          <LastUpdated date={lastUpdatedIso} variant="onDark" class="mb-6" />
          <p class="text-white/80 text-lg md:text-xl max-w-3xl mx-auto" style="font-family: Georgia, serif;">
            Independent research, personalized guidance, and premium educational resources for investors navigating the EB-5 process.
          </p>
        </div>
      </section>

      <!-- TODO: Replace privateClientStats placeholders with confirmed PCS metrics -->
      <section class="py-12 md:py-16 px-8 bg-[hsl(0,0%,97%)]" aria-label="Private Client Services statistics">
        <div class="container mx-auto">
          <StatsRow stats={privateClientStats} />
        </div>
      </section>

      <section class="py-20">
        <div class="container mx-auto px-4 max-w-5xl">
          <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
            <a href={primaryService.href} class="group md:col-span-7 md:row-span-2 block">
              <Card className="h-full rounded-lg border border-border hover:border-primary hover:shadow-medium transition-all duration-300">
                <CardHeader className="p-8 md:p-10 pb-4">
                  <span className="block text-sm font-medium text-muted-foreground tracking-wider mb-4">
                    {primaryService.numeral}
                  </span>
                  <h2 className="font-serif text-2xl md:text-3xl font-bold text-foreground group-hover:text-primary transition-colors">
                    {primaryService.title}
                  </h2>
                </CardHeader>
                <CardContent className="p-8 md:p-10 pt-0">
                  <p className="text-muted-foreground leading-relaxed" style="font-family: Georgia, serif; line-height: 1.75;">
                    {primaryService.description}
                  </p>
                  <span className="inline-block mt-8 text-primary font-medium text-sm uppercase tracking-wider group-hover:underline">
                    {primaryService.cta}
                  </span>
                </CardContent>
              </Card>
            </a>

            {
              secondaryServices.map((service) => (
                <a href={service.href} class="group md:col-span-5 block">
                  <Card className="h-full rounded-lg border border-border hover:border-primary hover:shadow-medium transition-all duration-300">
                    <CardHeader className="p-6 md:p-8 pb-3">
                      <span className="block text-sm font-medium text-muted-foreground tracking-wider mb-3">
                        {service.numeral}
                      </span>
                      <h2 className="font-serif text-xl md:text-2xl font-bold text-foreground group-hover:text-primary transition-colors">
                        {service.title}
                      </h2>
                    </CardHeader>
                    <CardContent className="p-6 md:p-8 pt-0">
                      <p className="text-muted-foreground leading-relaxed text-sm md:text-base" style="font-family: Georgia, serif; line-height: 1.75;">
                        {service.description}
                      </p>
                      <span className="inline-block mt-6 text-primary font-medium text-sm uppercase tracking-wider group-hover:underline">
                        {service.cta}
                      </span>
                    </CardContent>
                  </Card>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <section class="py-16 bg-muted/30">
        <div class="container mx-auto px-4 max-w-4xl text-center">
          <h2 class="font-serif text-3xl font-bold text-foreground mb-6">
            Built for Informed Decision-Making
          </h2>
          <p class="text-muted-foreground leading-relaxed" style="font-family: Georgia, serif; line-height: 1.75;">
            StudentEB5 Private Client Services extend our public educational mission with focused support for investors who require deeper analysis, structured dialogue, and carefully curated reference materials. Every engagement remains educational in nature and does not constitute legal or financial advice.
          </p>
        </div>
      </section>
    </main>

    <Footer client:visible />
  </div>
</Layout>
