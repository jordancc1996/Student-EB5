---
import Layout from '../../layouts/Layout.astro';
import Header from '@/components/Header';
import SiteFooter from '@/components/SiteFooter.astro';
import PreferredSourcesCTA from '@/components/PreferredSourcesCTA.astro';
import Breadcrumb from '@/components/Breadcrumb';
import JourneyCTA from '@/components/JourneyCTA.astro';
import PrivateStrategySessionsContent from '@/components/private-client/PrivateStrategySessionsContent';
import LastUpdated from '@/components/LastUpdated.astro';
import { ConsultationCTA } from '@/components/ConsultationCTA';
import { Toaster } from '@/components/ui/toaster';
import { SITE_CONFIG } from '@/lib/seo/config';
import { generateWebPageSchema } from '@/lib/seo/structured-data';
import { getPageLastUpdated } from '@/lib/pageFreshness';

const title = 'Private Strategy Sessions | Private Client Services | StudentEB5';
const description =
  'One-on-one educational consultations designed to help prospective EB-5 investors organize their planning before engaging legal and financial professionals.';
const pageCanonical = `${SITE_CONFIG.url}/private-client-services/private-strategy-sessions`;
const ogImage = `${SITE_CONFIG.url}/og-image.jpg`;
const keywords = [
  'EB-5 strategy session',
  'private EB-5 consultation',
  'EB-5 investor planning',
  'educational EB-5 consultation',
  'private strategy session',
];

const breadcrumbs = [
  { name: 'Home', url: SITE_CONFIG.url },
  { name: 'Private Client Services', url: `${SITE_CONFIG.url}/private-client-services` },
  { name: 'Private Strategy Sessions', url: pageCanonical },
];

const lastUpdatedIso = getPageLastUpdated('/private-client-services/private-strategy-sessions');
const structuredData = generateWebPageSchema(
  'Private Strategy Sessions',
  description,
  pageCanonical,
  breadcrumbs,
  lastUpdatedIso,
);
---

<Layout>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <link rel="canonical" href={pageCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/https:\/\/www\.studenteb5\.com/g, SITE_CONFIG.url)} />
  </Fragment>

  <div class="min-h-screen bg-gradient-to-br from-background to-secondary/20">
    <Header client:load />

    <main class="container mx-auto px-6 py-8">
      <Breadcrumb client:load initialPathname="/private-client-services/private-strategy-sessions" />
      <LastUpdated date={lastUpdatedIso} class="mb-4 mt-2" />
      <PreferredSourcesCTA />
      <PrivateStrategySessionsContent />
    </main>

    <ConsultationCTA client:visible />
    <JourneyCTA />
    <SiteFooter />
    <Toaster client:load />
  </div>
</Layout>
