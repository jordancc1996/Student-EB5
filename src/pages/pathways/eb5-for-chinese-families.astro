---
import PathwayLandingLayout from '../../layouts/PathwayLandingLayout.astro';
import { getPathwayHero } from '@/lib/pathwayHeroes';
import ProcessFaqAccordion from '@/components/ProcessFaqAccordion';
import { SITE_CONFIG } from '@/lib/seo/config';
import { generateFAQSchema } from '@/lib/seo/structured-data';

const title =
  'EB-5 for Chinese Families - Funding a Child | StudentEB5';
const metaDescription =
  'EB-5 for Chinese families covers gifts, source of funds, and documents before parents fund a child. Read the funding steps.';
const canonicalUrl = `${SITE_CONFIG.url}/pathways/eb5-for-chinese-families`;
const h1 = 'How Chinese Parents Can Fund an EB-5 Investment for a Child Studying in the U.S.';
const subhead =
  'What families need to document before moving capital toward a child\'s EB-5 investment, and why the paper trail matters as much as the funds.';

const relatedResearch = [
  {
    title: 'Ways to Fund EB-5: Gifted, Loaned, and Crypto Paths',
    url: '/research/ways-to-fund-eb5-investment-2026',
    description: 'Gift, loan, and other lawful funding paths USCIS reviews when the investor\'s capital is coming from China.',
  },
  {
    title: 'What to Know Before Investing in EB-5',
    url: '/research/investment/what-to-know-before-investing-in-eb5',
    description: 'What a Chinese family should verify before committing capital and filing Form I-526E.',
  },
  {
    title: 'EB-5 for Chinese International Students',
    url: '/pathways/eb5-for-chinese-students',
    description: 'Student-side decision framing for Chinese F-1 applicants evaluating EB-5.',
  },
];

const faqItems = [
  {
    question: 'Does the student have to prove they earned the investment money themselves?',
    answer:
      'No. Gifted funds are commonly used in EB-5 cases. What matters is that the original source of the funds (usually the parent\'s) is lawful and well documented.',
  },
  {
    question: 'How far back does source of funds documentation need to go?',
    answer:
      'This depends on the specific funding history and case, and current USCIS practice can change. An immigration attorney experienced in EB-5 source-of-funds cases should review the specific facts before a family finalizes a funding plan.',
  },
  {
    question: 'What if funds come from a business the parent owns in China?',
    answer:
      'Business income can be used as a source of funds, but it typically requires more extensive documentation: business licenses, tax filings, audited financials, and a clear link between the business income and the gifted funds. This is an area where working with an adviser familiar with both Chinese business documentation and USCIS expectations matters most.',
  },
];
const hero = getPathwayHero('eb5-for-chinese-families');
const safeNoticeUrl = 'https://www.safe.gov.cn/tianjin/2025/1113/2926.html';
const safeEnglishUrl = 'https://www.safe.gov.cn/en/2017/0119/1244.html';

---

<PathwayLandingLayout
  title={title}
  metaDescription={metaDescription}
  canonicalUrl={canonicalUrl}
  h1={h1}
  subhead={subhead}
  heroImage={hero.image}
  heroImageWebp={hero.webp}
  heroImageAlt="EB-5 pathway for Chinese families"
  relatedResearch={relatedResearch}
  secondaryCtaText="Talk with someone about an EB-5 remittance from China"
  breadcrumbTitle="EB-5 for Chinese Families"
  keywords={[
    'Chinese parents EB-5 funding',
    'EB-5 gift funds China',
    'EB-5 source of funds parents',
    'fund EB-5 for child in US',
  ]}
>
  <Fragment slot="extraCompliance">
    <p class="text-sm text-muted-foreground leading-relaxed border border-border rounded-lg bg-secondary/40 p-4 m-0">
      This page provides educational information about EB-5 funding from China and does not constitute legal, financial, tax, or immigration advice.
      Consult a qualified immigration attorney and a cross-border tax adviser before a family in China moves investment capital or signs a gift arrangement.
    </p>
  </Fragment>

  <script type="application/ld+json" set:html={JSON.stringify(generateFAQSchema(faqItems))} />

  <h2>Who this page is for</h2>
  <p>
    In many EB-5 cases involving Chinese international students, the child is the investor of record, but a parent or
    other family member is the actual source of the funds.
    The gift letter for a Chinese parent, and the records that show the gift reached the student, are on the
    <a href="/pathways/eb5-gifted-funds">EB-5 with gifted funds</a> page.
    The lawful-source file for capital from China is on the
    <a href="/pathways/eb5-source-of-funds">EB-5 source of funds</a> page.
    The student decision for a Chinese F-1 applicant is on the
    <a href="/pathways/eb5-for-chinese-students">EB-5 for Chinese international students</a> page.
  </p>

  <h2>How the gift structure typically works</h2>
  <p>
    For a Chinese family, start with the
    <a href="/pathways/eb5-gifted-funds">EB-5 with gifted funds</a> page and the
    <a href="/pathways/eb5-source-of-funds">EB-5 source of funds</a> page rather than restating those steps here.
  </p>
  <p>
    The State Administration of Foreign Exchange sets an annual facilitation quota of USD 50,000 equivalent per person for an individual's purchase of foreign exchange and for settlement of foreign exchange.
  </p>
  <p>
    A <a href={safeNoticeUrl} target="_blank" rel="noopener noreferrer">November 13, 2025 notice from the SAFE Tianjin branch</a> cites Huifa [2020] No. 14 for that per-person annual quota.
  </p>
  <p>
    Above the quota, a <a href={safeEnglishUrl} target="_blank" rel="noopener noreferrer">current-account purchase</a> requires the bank to review documents that show the transaction.
  </p>

  <h2>Common documentation questions</h2>
  <div class="not-prose mb-8">
    <ProcessFaqAccordion client:load items={faqItems} />
  </div>

  <h2>Tax and advisory considerations</h2>
  <p>
    This page does not give tax advice for capital moving from China to an EB-5 investment.
    A family in China should have a cross-border tax adviser and a United States immigration attorney review the transfer before money moves.
  </p>
</PathwayLandingLayout>
