import { SITE_CONFIG } from '@/lib/seo/config';

const title = 'EB-5 for Indian H-1B Professionals | StudentEB5';
const metaDescription =
  'EB-5 for Indian H-1B professionals explains why India EB-2/EB-3 backlog dynamics lead some holders to evaluate EB-5’s different visa allocation mechanics, including consulting-arrangement workers.';
const canonicalUrl = `${SITE_CONFIG.url}/pathways/eb5-for-indian-h1b`;
const h1 = 'EB-5 for Indian H-1B Professionals';
const subhead =
  'Why some Indian H-1B holders evaluate EB-5 when employment-based green card timelines tied to India chargeability feel out of their control.';

const relatedResearch = [
  {
    title: 'Best Immigration Backup Plan for Indian Tech Workers',
    url: '/research/best-immigration-backup-plan-indian-tech-workers-2026',
    description: 'Parallel planning for Indian tech workers facing lottery and backlog uncertainty.',
  },
  {
    title: 'H-1B to Green Card via EB-5',
    url: '/pathways/h1b-to-green-card',
    description: 'Shared H-1B concurrent-filing and employer-independence mechanics.',
  },
