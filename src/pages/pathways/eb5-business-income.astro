---
import PathwayLandingLayout from '../../layouts/PathwayLandingLayout.astro';
import { getPathwayCategoryHero } from '@/lib/pathwayHeroes';
import { SITE_CONFIG } from '@/lib/seo/config';

const title = 'EB-5 With Business Income | StudentEB5';
const metaDescription =
  'Using business ownership income as EB-5 source of funds: how operating-company earnings can support a petition showing, with links for entrepreneurs and the fuller funding guide.';
const canonicalUrl = `${SITE_CONFIG.url}/pathways/eb5-business-income`;
const h1 = 'EB-5 With Business Income';
const subhead =
  'How income from a business you own can figure into an EB-5 source-of-funds showing when ownership and distributions are clearly documented.';

const relatedResearch = [
  {
    title: 'EB-5 for Entrepreneurs & Business Owners',
    url: '/pathways/eb5-for-entrepreneurs',
    description: 'Broader framing for established operators evaluating EB-5.',
  },
  {
    title: 'Ways to Fund EB-5: Gifted, Loaned, and Crypto Paths',
    url: '/research/ways-to-fund-eb5-investment-2026',
    description: 'Primary research overview of lawful funding paths.',
  },
];
const hero = getPathwayCategoryHero('source-of-funds');

---

<PathwayLandingLayout
  title={title}
  metaDescription={metaDescription}
  canonicalUrl={canonicalUrl}
  h1={h1}
  subhead={subhead}
  heroImage={hero.image}
  heroImageWebp={hero.webp}
  heroImageAlt="EB-5 pathway for business-income funds"
  relatedResearch={relatedResearch}
  secondaryCtaText="Talk to Someone About Business Income for EB-5"
  breadcrumbTitle="EB-5 Business Income"
  keywords={['EB-5 business income', 'EB-5 company earnings source of funds', 'business owner EB-5']}
>
  <p>
    Business income can support an EB-5 source-of-funds showing when the investor can document ownership, the company’s
    lawful earnings, and a clear path from those earnings (or distributions) into the invested capital. Corporate
    registrations, tax filings, and financial statements are commonly part of that record. The exact package depends on
    the jurisdiction and business structure.
  </p>
  <p>
    Established operators evaluating EB-5 more broadly should also read
    <a href="/pathways/eb5-for-entrepreneurs">EB-5 for entrepreneurs &amp; business owners</a>. For the fuller menu of
    funding structures, see
    <a href="/research/ways-to-fund-eb5-investment-2026">ways to fund an EB-5 investment</a> and the umbrella page
    <a href="/pathways/eb5-source-of-funds">EB-5 source of funds</a>.
  </p>
</PathwayLandingLayout>
