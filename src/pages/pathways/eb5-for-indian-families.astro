---
import PathwayLandingLayout from '../../layouts/PathwayLandingLayout.astro';
import { getPathwayHero } from '@/lib/pathwayHeroes';
import ProcessFaqAccordion from '@/components/ProcessFaqAccordion';
import { SITE_CONFIG } from '@/lib/seo/config';
import { generateFAQSchema } from '@/lib/seo/structured-data';

const title = 'How Indian Families Can Fund an EB-5 Investment | StudentEB5';
const metaDescription =
  'EB-5 for Indian families covers gifts, source of funds, and documents before capital moves, including LRS factors. Read the checklist.';
const canonicalUrl = `${SITE_CONFIG.url}/pathways/eb5-for-indian-families`;
const h1 = 'How Indian Families Can Fund an EB-5 Investment';
const subhead =
  'What families need to document before moving capital toward an EB-5 investment, and why the paper trail matters as much as the funds.';

const relatedResearch = [
  {
    title: 'EB-5 for Indian International Students',
    url: '/pathways/eb5-for-indian-students',
    description: 'Student-side decision framing for Indian F-1 applicants evaluating EB-5.',
  },
  {
    title: 'Ways to Fund EB-5: Gifted, Loaned, and Crypto Paths',
    url: '/research/ways-to-fund-eb5-investment-2026',
    description: 'Gift, loan, and other lawful funding paths USCIS reviews when the investor\'s capital is coming from India.',
  },
  {
    title: 'What to Know Before Investing in EB-5',
    url: '/research/investment/what-to-know-before-investing-in-eb5',
    description: 'What an Indian family should verify before committing capital and filing Form I-526E.',
  },
];

const faqItems = [
  {
    question: 'Does the student have to prove they earned the investment money themselves?',
    answer:
      'No. Gifted funds are commonly used in EB-5 cases. What matters is that the original source of the funds (usually the parent\'s) is lawful and well documented.',
  },
  {
    question: 'How far back does source of funds documentation need to go?',
    answer:
      'This depends on the specific funding history and case, and current USCIS practice can change. An immigration attorney experienced in EB-5 source-of-funds cases should review the specific facts before a family finalizes a funding plan.',
  },
  {
    question: 'What if funds come from a business the parent owns in India?',
    answer:
      'Business income can be used as a source of funds, but it typically requires more extensive documentation: business registrations, tax filings, financial statements, and a clear link between the business income and the gifted funds. This is an area where working with an adviser familiar with both Indian business documentation and USCIS expectations matters most.',
  },
];
const hero = getPathwayHero('eb5-for-indian-families');
const rbiLrsUrl = 'https://www.rbi.org.in/Scripts/BS_ViewMasterDirections.aspx?id=10192';

---

<PathwayLandingLayout
  title={title}
  metaDescription={metaDescription}
  canonicalUrl={canonicalUrl}
  h1={h1}
  subhead={subhead}
  heroImage={hero.image}
  heroImageWebp={hero.webp}
  heroImageAlt="EB-5 pathway for Indian families"
  relatedResearch={relatedResearch}
  secondaryCtaText="Talk with someone about an EB-5 remittance from India"
  breadcrumbTitle="EB-5 for Indian Families"
  keywords={[
    'Indian parents EB-5 funding',
    'EB-5 gift funds India',
    'LRS EB-5 remittance',
    'fund EB-5 for child in US',
  ]}
>
  <Fragment slot="extraCompliance">
    <p class="text-sm text-muted-foreground leading-relaxed border border-border rounded-lg bg-secondary/40 p-4 m-0">
      This page provides educational information about EB-5 funding from India and does not constitute legal, financial, tax, or immigration advice.
      Consult a qualified immigration attorney and a cross-border tax adviser before a family in India moves investment capital or signs a gift arrangement.
    </p>
  </Fragment>

  <script type="application/ld+json" set:html={JSON.stringify(generateFAQSchema(faqItems))} />

  <h2>Who this page is for</h2>
  <p>
    In many EB-5 cases involving Indian international students or young professionals, the child is the investor of
    record, but a parent or other family member is the actual source of the funds.
    The gift letter for an Indian parent, and the records that show the gift reached the student, are on the
    <a href="/pathways/eb5-gifted-funds">EB-5 with gifted funds</a> page.
    The lawful-source file those records have to support is on the
    <a href="/pathways/eb5-source-of-funds">EB-5 source of funds</a> page.
    The student decision for an Indian F-1 applicant is on the
    <a href="/pathways/eb5-for-indian-students">EB-5 for Indian international students</a> page.
  </p>

  <h2>How the gift structure typically works</h2>
  <p>
    For an Indian family, start with the
    <a href="/pathways/eb5-gifted-funds">EB-5 with gifted funds</a> page and the
    <a href="/pathways/eb5-source-of-funds">EB-5 source of funds</a> page rather than restating those steps here.
  </p>
  <p>
    Under the Reserve Bank of India
    <a href={rbiLrsUrl} target="_blank" rel="noopener noreferrer">Liberalised Remittance Scheme</a>, an authorised dealer may allow a resident individual to remit up to USD 250,000 per financial year, April through March, for a permitted current or capital account transaction.
  </p>
  <p>
    The scheme is not available to companies, partnership firms, Hindu Undivided Families, or trusts.
  </p>
  <p>
    A resident individual may remit up to that annual amount as a gift to a person resident outside India.
  </p>
  <p>
    For a capital-account remittance, the
    <a href={rbiLrsUrl} target="_blank" rel="noopener noreferrer">Master Direction</a>
    tells the bank to obtain the prior-year bank statement or, if none is available, the latest income-tax assessment order or return.
  </p>
  <p>
    The same direction says banks should not extend credit to a resident individual to fund a capital-account remittance under the scheme.
  </p>

  <h2>Common documentation questions</h2>
  <div class="not-prose mb-8">
    <ProcessFaqAccordion client:load items={faqItems} />
  </div>

  <h2>Tax and advisory considerations</h2>
  <p>
    This page does not give tax advice for capital moving from India to an EB-5 investment.
    A family in India should have a cross-border tax adviser and a United States immigration attorney review the transfer before money moves.
    For funding-path options and a pre-filing checklist, see
    <a href="/research/ways-to-fund-eb5-investment-2026">ways to fund an EB-5 investment</a> and the
    <a href="/research/investment/what-to-know-before-investing-in-eb5">What to Know Before Investing in EB-5</a>.
  </p>
</PathwayLandingLayout>
