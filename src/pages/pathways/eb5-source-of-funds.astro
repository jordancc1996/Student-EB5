---
import PathwayLandingLayout from '../../layouts/PathwayLandingLayout.astro';
import ProcessFaqAccordion from '@/components/ProcessFaqAccordion';
import { SITE_CONFIG } from '@/lib/seo/config';

const title = 'EB-5 Source of Funds | StudentEB5';
const metaDescription =
  'EB-5 source of funds covers gifted, loaned, inherited, property-sale, and business-income paths, plus how source of funds differs from source of wealth — with links to deeper funding guides.';
const canonicalUrl = `${SITE_CONFIG.url}/pathways/eb5-source-of-funds`;
const h1 = 'EB-5 Source of Funds';
const subhead =
  'How USCIS looks at where EB-5 capital came from, how it moved, and how that differs from a broader source-of-wealth review.';

const relatedResearch = [
  {
    title: 'Ways to Fund EB-5 — Gifted, Loaned, and Crypto Paths',
    url: '/research/ways-to-fund-eb5-investment-2026',
    description: 'Primary research overview of lawful funding paths for EB-5 capital.',
  },
  {
    title: 'EB-5 With Gifted Funds',
    url: '/pathways/eb5-gifted-funds',
    description: 'Gifts from family members as a funding structure.',
  },
  {
    title: 'EB-5 With Proceeds From Property Sale',
    url: '/pathways/eb5-property-sale-funds',
    description: 'Using property-sale proceeds as invested capital.',
  },
  {
    title: 'EB-5 With Business Income',
    url: '/pathways/eb5-business-income',
    description: 'Using business ownership income in a source-of-funds showing.',
  },
];

const faqItems = [
  {
    question: 'What happens if my source of funds is questioned or denied?',
    answer:
      'USCIS may issue a Request for Evidence (RFE) asking for additional documentation when a source-of-funds showing needs clarification. An RFE is a normal part of adjudication for many petitions — it is not an automatic denial. Working with an experienced EB-5 attorney from the start can help assemble a clearer record and reduce the chance of avoidable RFEs, but no approach assures approval or prevents every request for more evidence.',
  },
];
---

<PathwayLandingLayout
  title={title}
  metaDescription={metaDescription}
  canonicalUrl={canonicalUrl}
  h1={h1}
  subhead={subhead}
  relatedResearch={relatedResearch}
  secondaryCtaText="Talk to Someone About EB-5 Source of Funds"
  breadcrumbTitle="EB-5 Source of Funds"
  keywords={[
    'EB-5 source of funds',
    'EB-5 source of wealth',
    'EB-5 loaned funds',
    'EB-5 inherited funds',
  ]}
>
  <p>
    Every EB-5 petition must show that the invested capital came from a lawful source and can be traced into the
    qualifying investment. The deeper overview of funding structures is
    <a href="/research/ways-to-fund-eb5-investment-2026">ways to fund an EB-5 investment</a>. This page is the
    decision-stage map of the main paths.
  </p>

  <h2>Common funding paths</h2>
  <ul>
    <li>
      <a href="/pathways/eb5-gifted-funds">Gifted funds</a> — including gifts from any family member, not only parents.
      Parent-to-student country cases:
      <a href="/pathways/eb5-for-chinese-families">Chinese families</a> and
      <a href="/pathways/eb5-for-indian-families">Indian families</a>.
    </li>
    <li>
      <a href="/pathways/eb5-property-sale-funds">Property-sale proceeds</a> — sale documentation and path of funds into
      the investment.
    </li>
    <li>
      <a href="/pathways/eb5-business-income">Business income</a> — ownership income documented through corporate and tax
      records.
    </li>
  </ul>

  <h2>Loaned funds</h2>
  <p>
    Funds borrowed against an asset (for example, a secured loan) can be an acceptable source when the loan itself and
    the underlying collateral history meet the same lawful-source and path-of-funds documentation standard as any other
    source. Loan terms, repayment capacity, and the origin of the pledged asset typically all need a clear paper trail.
  </p>

  <h2>Inherited funds</h2>
  <p>
    Inheritance is a common and often well-documented source. Cases typically rely on estate, probate, or equivalent
    succession records showing how assets passed to the investor, then bank records showing how those funds moved into
    the investment.
  </p>

  <h2>Source of funds vs. source of wealth</h2>
  <p>
    These are related but distinct concepts. Source of funds traces the specific dollars used for the EB-5 investment.
    Source of wealth looks at the investor’s broader financial history — how they accumulated assets over time. USCIS may
    examine both. A clean gift letter does not replace an explanation of how the donor built the wealth behind the gift.
  </p>

  <h2>If USCIS questions the showing</h2>
  <div class="not-prose mb-8">
    <ProcessFaqAccordion client:load items={faqItems} />
  </div>
</PathwayLandingLayout>
