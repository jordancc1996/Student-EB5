---
import PathwayLandingLayout from '../../layouts/PathwayLandingLayout.astro';
import { SITE_CONFIG } from '@/lib/seo/config';

const title = 'EB-5 With Proceeds From Property Sale | StudentEB5';
const metaDescription =
  'Using property-sale proceeds as EB-5 source of funds — what the documentation trail typically needs to show, with a hand-off to the fuller funding research guide.';
const canonicalUrl = `${SITE_CONFIG.url}/pathways/eb5-property-sale-funds`;
const h1 = 'EB-5 With Proceeds From Property Sale';
const subhead =
  'How sale proceeds can become EB-5 capital when ownership, sale, and bank movement are documented end to end.';

const relatedResearch = [
  {
    title: 'Ways to Fund EB-5 — Gifted, Loaned, and Crypto Paths',
    url: '/research/ways-to-fund-eb5-investment-2026',
    description: 'Primary research overview of lawful funding paths, including property-sale proceeds.',
  },
];
---

<PathwayLandingLayout
  title={title}
  metaDescription={metaDescription}
  canonicalUrl={canonicalUrl}
  h1={h1}
  subhead={subhead}
  relatedResearch={relatedResearch}
  secondaryCtaText="Talk to Someone About Property-Sale Funding for EB-5"
  breadcrumbTitle="EB-5 Property Sale Funds"
  keywords={['EB-5 property sale', 'EB-5 real estate proceeds', 'source of funds property sale']}
>
  <p>
    Proceeds from selling real estate are a frequent EB-5 funding source. A typical showing documents how the seller
    acquired the property, the sale itself (contract, closing statement, tax records where relevant), receipt of funds
    into a controlled account, and the subsequent transfer into the EB-5 investment or escrow — without unexplained gaps.
  </p>
  <p>
    Exact document lists vary by country and transaction history; that detail belongs in attorney-led preparation and in
    the fuller research guide
    <a href="/research/ways-to-fund-eb5-investment-2026">ways to fund an EB-5 investment</a>. For how this path sits next
    to gifts, loans, and business income, see
    <a href="/pathways/eb5-source-of-funds">EB-5 source of funds</a>.
  </p>
</PathwayLandingLayout>
