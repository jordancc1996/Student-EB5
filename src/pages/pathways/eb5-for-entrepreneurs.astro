---
import PathwayLandingLayout from '../../layouts/PathwayLandingLayout.astro';
import { SITE_CONFIG } from '@/lib/seo/config';

const title = 'EB-5 for Entrepreneurs & Business Owners | StudentEB5';
const metaDescription =
  'EB-5 for entrepreneurs and business owners covers established operators evaluating EB-5, including using business income as source of funds — distinct from startup-founder status planning.';
const canonicalUrl = `${SITE_CONFIG.url}/pathways/eb5-for-entrepreneurs`;
const h1 = 'EB-5 for Entrepreneurs & Business Owners';
const subhead =
  'For established business owners considering EB-5 — including how operating-company income can figure into source-of-funds documentation.';

const relatedResearch = [
  {
    title: 'EB-5 Business Income as Source of Funds',
    url: '/pathways/eb5-business-income',
    description: 'How business income can support EB-5 source-of-funds documentation.',
  },
  {
    title: 'Ways to Fund EB-5 — Gifted, Loaned, and Crypto Paths',
    url: '/research/ways-to-fund-eb5-investment-2026',
    description: 'Gift, loan, and other lawful funding paths USCIS reviews for EB-5 capital.',
  },
];
---

<PathwayLandingLayout
  title={title}
  metaDescription={metaDescription}
  canonicalUrl={canonicalUrl}
  h1={h1}
  subhead={subhead}
  relatedResearch={relatedResearch}
  secondaryCtaText="Talk to Someone About EB-5 for Business Owners"
  breadcrumbTitle="EB-5 for Entrepreneurs"
  keywords={[
    'EB-5 for entrepreneurs',
    'EB-5 business owners',
    'business income EB-5 source of funds',
    'established business EB-5',
  ]}
>
  <h2>Established operators, not early-stage founders</h2>
  <p>
    This page is for business owners who already run operating companies — trading, manufacturing, professional services,
    real estate operating businesses, and similar — and are evaluating EB-5 as a U.S. permanent-residence path. That is
    distinct from
    <a href="/pathways/eb5-for-startup-founders">startup founders</a>, whose primary friction is often status independence
    from a company they control while it is still being built. Here, the conversation more often centers on capital
    availability, cross-border documentation, and whether business income can support a lawful source-of-funds narrative.
  </p>

  <h2>Business income as source of funds</h2>
  <p>
    USCIS can accept business income as part of an EB-5 source-of-funds showing when the trail is clear: ownership,
    tax filings, financial statements, and a documented path from the business to the investor and then into the
    qualifying investment. Requirements are fact-specific and documentation-heavy. See
    <a href="/pathways/eb5-business-income">EB-5 business income as source of funds</a> for that dedicated discussion, and
    <a href="/research/ways-to-fund-eb5-investment-2026">ways to fund an EB-5 investment</a> for other lawful structures
    (including gifts and loans) that owners sometimes combine with operating income.
  </p>

  <h2>Immigration and business decisions stay separate reviews</h2>
  <p>
    Moving capital out of an operating company for an EB-5 investment can affect liquidity, minority shareholders, tax
    exposure, and local corporate rules — issues that sit outside immigration adjudication. Treat the immigration
    attorney review and the corporate/tax adviser review as parallel workstreams before funds move. EB-5 does not
    guarantee visa availability or petition approval.
  </p>
</PathwayLandingLayout>
