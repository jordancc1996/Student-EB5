---
import PathwayLandingLayout from '../../layouts/PathwayLandingLayout.astro';
import { getPathwayCategoryHero } from '@/lib/pathwayHeroes';
import { SITE_CONFIG } from '@/lib/seo/config';

const title = 'EB-5 With Gifted Funds | StudentEB5';
const metaDescription =
  'EB-5 with gifted funds covers gifts from family members as a lawful source of capital, how they overlap with parent-funding pages, and where to read the fuller funding research.';
const canonicalUrl = `${SITE_CONFIG.url}/pathways/eb5-gifted-funds`;
const h1 = 'EB-5 With Gifted Funds';
const subhead =
  'How gifted capital can support an EB-5 investment when the donor’s original source and the path of funds are clearly documented.';

const relatedResearch = [
  {
    title: 'Ways to Fund EB-5: Gifted, Loaned, and Crypto Paths',
    url: '/research/ways-to-fund-eb5-investment-2026',
    description: 'Primary research overview of gift and other lawful funding paths.',
  },
  {
    title: 'How Chinese Parents Can Fund an EB-5 Investment',
    url: '/pathways/eb5-for-chinese-families',
    description: 'Parent-to-child gift mechanics for China-side capital.',
  },
  {
    title: 'How Indian Families Can Fund an EB-5 Investment',
    url: '/pathways/eb5-for-indian-families',
    description: 'Parent-to-child gift mechanics and LRS/RBI planning for India-side capital.',
  },
];
const hero = getPathwayCategoryHero('source-of-funds');

---

<PathwayLandingLayout
  title={title}
  metaDescription={metaDescription}
  canonicalUrl={canonicalUrl}
  h1={h1}
  subhead={subhead}
  heroImage={hero.image}
  heroImageWebp={hero.webp}
  heroImageAlt="EB-5 pathway for gifted EB-5 funds"
  relatedResearch={relatedResearch}
  secondaryCtaText="Talk to Someone About Gifted Funds for EB-5"
  breadcrumbTitle="EB-5 Gifted Funds"
  keywords={['EB-5 gifted funds', 'EB-5 gift letter', 'family gift EB-5']}
>
  <p>
    Gifted funds are widely used in EB-5. The investor of record does not have to have personally earned the capital;
    a parent, spouse, sibling, or other family member may gift it. USCIS still looks through to the donor’s lawful
    original source and requires a complete trail from donor to investor to the new commercial enterprise or escrow.
  </p>
  <p>
    Parent-to-student cases with country-specific remittance issues are covered in depth on
    <a href="/pathways/eb5-for-chinese-families">EB-5 for Chinese families</a> and
    <a href="/pathways/eb5-for-indian-families">EB-5 for Indian families</a>. This page is the broader gift umbrella:
    any qualifying family gift structure, not only parents. For the fuller funding research (including how gifts sit
    next to loans and other paths), see
    <a href="/research/ways-to-fund-eb5-investment-2026">ways to fund an EB-5 investment</a> and the map page
    <a href="/pathways/eb5-source-of-funds">EB-5 source of funds</a>.
  </p>
</PathwayLandingLayout>
