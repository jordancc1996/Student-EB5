---
import Layout from '../layouts/Layout.astro';
import Header from '@/components/Header';
import SiteFooter from '@/components/SiteFooter.astro';
import PreferredSourcesCTA from '@/components/PreferredSourcesCTA.astro';
import Breadcrumb from '@/components/Breadcrumb';
import ToolsHubMainContent from '@/components/ToolsHubMainContent';
import { SITE_CONFIG } from '@/lib/seo/config';

const title = 'EB-5 Immigration Tools and Calculators';
const description =
  'EB-5 immigration tools calculators cover OPT timelines, $800,000 feasibility checks, H-1B lottery odds, and the Sept 30, 2026 grandfathering countdown.';
const pageCanonical = `${SITE_CONFIG.url}/eb5-investment-immigration-tools`;
const ogTitle = `${title} | StudentEB5`;
const ogDescription = description;
const ogImage = `${SITE_CONFIG.url}/og-image.jpg`;
const keywords = [
  'EB-5 immigration tools calculators',
  'EB-5 feasibility calculator',
  'OPT calculator EB-5',
  'EB-5 grandfathering countdown',
];

const toolsList = [
  { href: '/tools/tuition-calculator', name: 'Tuition Savings Calculator' },
  { href: '/tools/grandfathering-countdown', name: 'Grandfathering Countdown' },
  { href: '/tools/opt-calculator', name: 'OPT Calculator' },
  { href: '/tools/h1b-lottery-odds-calculator', name: 'H-1B Lottery Odds Calculator' },
  { href: '/tools/2026-eb5-investment-feasibility-calculator', name: 'EB-5 Feasibility Calculator' },
  { href: '/tools/source-of-funds-calculator', name: 'Source of Funds Calculator' },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'EB-5 Immigration Tools and Calculators',
    url: pageCanonical,
    description:
      'EB-5 immigration tools calculators cover OPT timelines, $800,000 feasibility checks, H-1B lottery odds, and the Sept 30, 2026 grandfathering countdown.',
    isPartOf: { '@type': 'WebSite', name: SITE_CONFIG.name, url: SITE_CONFIG.url },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: toolsList.map((t, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: t.name,
        url: `${SITE_CONFIG.url}${t.href}`,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_CONFIG.url },
      { '@type': 'ListItem', position: 2, name: 'Tools', item: pageCanonical },
    ],
  },
];
---

<Layout>
  <Fragment slot="head">
    <title>{title} | StudentEB5</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <link rel="canonical" href={pageCanonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    {
      structuredData.map((data) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(data).replace(/https:\/\/www\.studenteb5\.com/g, SITE_CONFIG.url)}
        />
      ))
    }
  </Fragment>

  <div class="min-h-screen bg-gradient-to-br from-background to-secondary/20">
    <Header client:load />

    <PreferredSourcesCTA />

    <ToolsHubMainContent>
      <Breadcrumb client:load initialPathname="/eb5-investment-immigration-tools" />
    </ToolsHubMainContent>

    <SiteFooter />
  </div>
</Layout>
