---
import Layout from '../layouts/Layout.astro';
import Header from '@/components/Header';
import Footer from '@/components/Footer';
import Breadcrumb from '@/components/Breadcrumb';
import ResourcesMainContent from '@/components/ResourcesMainContent';
import JourneyCTA from '@/components/JourneyCTA.astro';
import { ConsultationCTA } from '@/components/ConsultationCTA';
import { Toaster } from '@/components/ui/toaster';
import { SITE_CONFIG } from '@/lib/seo/config';
import { generateWebPageSchema } from '@/lib/seo/structured-data';

const title = 'EB-5 Resources for International Students';
const description =
  'EB-5 resources international students need include filing guides, source-of-funds checklists, research articles, and tools tied to the Sept 30, 2026 deadline.';
const pageCanonical = `${SITE_CONFIG.url}/resources`;
const ogTitle = `${title} | StudentEB5`;
const ogDescription = description;
const ogImage = `${SITE_CONFIG.url}/og-image.jpg`;
const keywords = [
  'EB-5 resources international students',
  'EB-5 guides for students',
  'EB-5 source of funds resources',
  'EB-5 research for F-1 students',
];

const breadcrumbs = [
  { name: 'Home', url: SITE_CONFIG.url },
  { name: 'Resources', url: `${SITE_CONFIG.url}/resources` },
];

const structuredData = generateWebPageSchema(
  title,
  description,
  `${SITE_CONFIG.url}/resources`,
  breadcrumbs
);
---

<Layout>
  <Fragment slot="head">
    <title>{title} | StudentEB5</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <link rel="canonical" href={pageCanonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/https:\/\/www\.studenteb5\.com/g, SITE_CONFIG.url)} />
  </Fragment>

  <div class="min-h-screen bg-gradient-to-br from-background to-secondary/20">
    <Header client:load />

    <main class="container mx-auto px-6 pt-4 pb-8">
      <Breadcrumb client:load initialPathname="/resources" />
      <ResourcesMainContent />
    </main>

    <ConsultationCTA client:visible />
    <JourneyCTA />
    <Footer client:visible />
    <Toaster client:load />
  </div>
</Layout>
