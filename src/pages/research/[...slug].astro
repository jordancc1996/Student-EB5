---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '@/components/Header';
import SiteFooter from '@/components/SiteFooter.astro';
import LegalDisclaimer from '@/components/LegalDisclaimer.astro';
import { getResearchHero } from '@/lib/images/researchHero';
import { ConsultationCTA } from '@/components/ConsultationCTA';
import { Toaster } from '@/components/ui/toaster';
import ShareButtons from '@/components/ShareButtons';
import MidArticleCTA from '@/components/MidArticleCTA';
import PostIntroCTA from '@/components/research/PostIntroCTA.astro';
import PreferredSourcesCTA from '@/components/PreferredSourcesCTA.astro';
import ArticleEmailContact from '@/components/ArticleEmailContact.astro';
import RelatedResearchCard from '@/components/RelatedResearchCard.astro';
import { SITE_CONFIG } from '@/lib/seo/config';
import { seoTitle } from '@/lib/seo/documentTitle';
import { generateArticleSchema } from '@/lib/seo/structured-data';
import {
  DEFAULT_OG_ALT,
  DEFAULT_OG_IMAGE,
  OG_IMAGE_HEIGHT,
  OG_IMAGE_WIDTH,
  absoluteShareImageUrl,
} from '@/lib/seo/shareImage';
import {
  splitArticleContent,
  splitArticleBeforeFirstH2,
  articleAlreadyHasPostIntroCta,
} from '@/lib/research/renderArticleContent';
import { extractArticleHeadings, buildTocItems } from '@/lib/research/articleHeadings';
import ArticleContents from '@/components/research/ArticleContents.astro';
import ArticleSideRail from '@/components/research/ArticleSideRail.astro';
import ArticleTocRail from '@/components/research/ArticleTocRail.astro';
import LastUpdated from '@/components/LastUpdated.astro';
import ArticleSummary from '@/components/ArticleSummary.astro';
import { resolveArticleLastUpdated, toIsoDate } from '@/lib/lastUpdated';
import { resolveArticlePathway } from '@/lib/research/resolveArticlePathway';
import {
  selectBottomRelatedPosts,
  selectRailRelatedResearch,
  type RelatedArticleCandidate,
} from '@/lib/research/relatedResearch';
import { injectEditorialPhotos } from '@/lib/photos/injectEditorialPhotos';
import PagePhotoCredits from '@/components/PagePhotoCredits.astro';
import H1bGracePeriodCalculator from '@/components/H1bGracePeriodCalculator';
import { GRACE_PERIOD_FAQS } from '@/lib/h1bGracePeriod';
import {
  H1B_GRACE_PERIOD_REGULATION_URL,
  USCIS_EB5_ADJUSTMENT,
  USCIS_H1B_NEW_PETITION,
  USCIS_POST_TERMINATION_OPTIONS,
  USCIS_TERMINATION_LINK_LABEL,
  USCIS_TERMINATION_OPTIONS_URL,
  USCIS_TERMINATION_PAGE_ARCHIVED,
  H1B_GRACE_PERIOD_MAX_DAYS,
} from '@/data/program';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('blog');
  return posts.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
};

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const post = entry.data;
const slug = post.slug;
const isGraceCalculator = slug === 'h1b-60-day-grace-period-layoff-guide';
const graceFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: GRACE_PERIOD_FAQS.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
const graceAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'H-1B grace period calculator',
  url: `${SITE_CONFIG.url}/research/h1b-60-day-grace-period-layoff-guide`,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description:
    'Estimates the earlier of 60 days after the last day of employment and the I-94 expiration date.',
};

if (!entry.body) {
  throw new Error(`Blog entry missing body: ${slug}`);
}

const hasHero = !!post.heroImage;
const hero = post.heroImage ? await getResearchHero(post.heroImage) : null;
const inlineHero = !post.heroImage && post.image ? await getResearchHero(post.image, '(max-width: 768px) 100vw, 740px') : null;
const pageCanonical = `${SITE_CONFIG.url}/research/${slug}`;
const metaTitle = seoTitle(post.metaTitle);
const ogCrop = post.heroImage
  ? await getImage({
      src: post.heroImage,
      width: OG_IMAGE_WIDTH,
      height: OG_IMAGE_HEIGHT,
      format: 'jpg',
      fit: 'cover',
      quality: 75,
    })
  : null;
const ogImage = ogCrop ? absoluteShareImageUrl(ogCrop.src) : DEFAULT_OG_IMAGE;
const ogImageAlt = post.imageAlt || DEFAULT_OG_ALT;
const lastUpdatedDisplay = resolveArticleLastUpdated(post.date, post.updatedDate);
const datePublishedIso = toIsoDate(post.date);
const dateModifiedIso = toIsoDate(lastUpdatedDisplay);

const articleSchema = {
  ...generateArticleSchema({
    headline: post.title,
    description: post.metaDescription,
    image: ogImage,
    datePublished: datePublishedIso,
    dateModified: dateModifiedIso,
    author: post.author,
    keywords: post.keywords.join(', '),
  }),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': pageCanonical,
  },
};

const articleBody = injectEditorialPhotos(
  entry.body,
  `/research/${slug}`,
  (post.editorialImages ?? []).map((item) => ({
    id: item.id,
    layout: item.layout ?? 'wide',
  })),
);
const { summaryHtml, introRemainderHtml, bodyMarkdown, showPostIntroCta } = await splitArticleBeforeFirstH2(articleBody);
const { firstHalfHtml, secondHalfHtml, showMidSplit } = await splitArticleContent(
  showPostIntroCta ? bodyMarkdown : articleBody,
);
const renderPostIntroCta =
  showPostIntroCta && !articleAlreadyHasPostIntroCta(entry.body);

const tocItems = buildTocItems(extractArticleHeadings(entry.body), post.tocLabels);

const articlePathway = resolveArticlePathway(slug, {
  pathwaySlug: post.pathwaySlug,
  category: post.category,
});

const allPosts = await getCollection('blog');
const researchCandidates: RelatedArticleCandidate[] = allPosts.map((p) => ({
  slug: p.data.slug,
  title: p.data.title,
  href: `/research/${p.data.slug}`,
  date: p.data.date,
  category: p.data.category,
  keywords: p.data.keywords,
  timestamp: new Date(p.data.date).getTime() || 0,
  image: p.data.heroImage,
}));
const bottomPicks = selectBottomRelatedPosts(
  { href: `/research/${slug}`, slug, category: post.category, keywords: post.keywords },
  post.relatedPosts,
  researchCandidates,
);
const postsBySlug = new Map(allPosts.map((p) => [p.data.slug, p.data]));
const relatedPosts = bottomPicks.map((pick) => {
  const related = postsBySlug.get(pick.slug);
  if (!related) throw new Error(`Missing related post ${pick.slug} for ${slug}`);
  return related;
});
const railRelated = selectRailRelatedResearch(
  { href: `/research/${slug}`, category: post.category, keywords: post.keywords },
  researchCandidates,
  bottomPicks.map((pick) => pick.href),
);
---

<Layout fullBleedHero={hasHero} ogImage={ogImage} ogImageAlt={ogImageAlt}>
  <Fragment slot="head">
    <title>{metaTitle}</title>
    <meta name="description" content={post.metaDescription} />
    <meta name="keywords" content={post.keywords.join(', ')} />
    <link rel="canonical" href={pageCanonical} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={post.metaDescription} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={post.metaDescription} />
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema).replace(/https:\/\/www\.studenteb5\.com/g, SITE_CONFIG.url)} />
    {
      isGraceCalculator && (
        <script type="application/ld+json" set:html={JSON.stringify(graceFaqSchema)} />
      )
    }
    {
      isGraceCalculator && (
        <script type="application/ld+json" set:html={JSON.stringify(graceAppSchema)} />
      )
    }
    {
      hero && (
        <link
          rel="preload"
          as="image"
          href={hero.src}
          imagesrcset={hero.srcset}
          imagesizes={hero.sizes}
          type="image/webp"
          fetchpriority="high"
        />
      )
    }
    {
      inlineHero && (
        <link
          rel="preload"
          as="image"
          href={inlineHero.src}
          imagesrcset={inlineHero.srcset}
          imagesizes={inlineHero.sizes}
          type="image/webp"
          fetchpriority="high"
        />
      )
    }
  </Fragment>

  <div class="min-h-screen bg-background research-article-page research-article-page--rail">
    <Header client:load />

    {
      hero && (
        <section class="relative pt-[120px] min-h-[60vh] flex items-center overflow-hidden">
          <img
            src={hero.src}
            srcset={hero.srcset}
            sizes={hero.sizes}
            alt={post.imageAlt}
            width={hero.width}
            height={hero.height}
            class="absolute inset-0 w-full h-full object-cover"
            loading="eager"
            decoding="sync"
            fetchpriority="high"
          />
          <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-black/60"></div>
          <div class="relative z-10 w-full py-16 text-white">
            <div class="article-editorial">
              <div class="article-title-block">
            <div class="editorial-kicker mb-4 text-white/80">
              {post.category}
            </div>
            <h1 class="research-article-title mb-6 drop-shadow-lg text-white text-left">
              {post.title}
            </h1>
            {isGraceCalculator && <H1bGracePeriodCalculator />}
            {isGraceCalculator && <script is:inline define:vars={{ graceDays: H1B_GRACE_PERIOD_MAX_DAYS }}>
              (function () {
                var last = document.getElementById('grace-last-day');
                var i94 = document.getElementById('grace-i94');
                if (!last || !i94 || !last.form) return;
                var form = last.form;
                var months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
                function addDays(iso, days) {
                  var match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(iso);
                  if (!match) return null;
                  var year = Number(match[1]);
                  var month = Number(match[2]);
                  var day = Number(match[3]);
                  var date = new Date(Date.UTC(year, month - 1, day));
                  if (date.getUTCFullYear() !== year || date.getUTCMonth() !== month - 1 || date.getUTCDate() !== day) return null;
                  date.setUTCDate(date.getUTCDate() + days);
                  return date.getUTCFullYear() + '-' + String(date.getUTCMonth() + 1).padStart(2, '0') + '-' + String(date.getUTCDate()).padStart(2, '0');
                }
                function format(iso) {
                  var match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(iso);
                  if (!match) return iso;
                  return months[Number(match[2]) - 1] + ' ' + Number(match[3]) + ', ' + match[1];
                }
                function sentence() {
                  var sixty = addDays(last.value, graceDays);
                  if (!sixty || !addDays(i94.value, 0)) return '';
                  var end = sixty <= i94.value ? sixty : i94.value;
                  var label = format(end);
                  if (sixty < i94.value) return 'The grace period ends on ' + label + ' because ' + graceDays + ' days after the last day of employment is earlier than the I-94 date.';
                  if (sixty > i94.value) return 'The grace period ends on ' + label + ' because the I-94 date is earlier than ' + graceDays + ' days after the last day of employment.';
                  return 'The grace period ends on ' + label + ' because ' + graceDays + ' days after the last day of employment and the I-94 date are the same day.';
                }
                function render() {
                  var existing = form.querySelector('[data-grace-result]');
                  var text = sentence();
                  if (!text) {
                    if (existing) existing.remove();
                    return;
                  }
                  if (!existing) {
                    existing = document.createElement('p');
                    existing.className = 'mt-3 text-sm text-foreground mb-0';
                    existing.setAttribute('data-grace-result', '');
                    form.insertBefore(existing, form.querySelector('p'));
                  }
                  existing.textContent = text;
                }
                form.addEventListener('input', render);
                form.dataset.graceReady = 'true';
              })();
            </script>}
            <div class="research-article-meta flex flex-wrap items-center justify-start gap-6 text-white/90 font-medium">
              <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5" aria-hidden="true"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
                <span>Published <time datetime={datePublishedIso}>{post.date}</time></span>
              </div>
              <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5" aria-hidden="true"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
                <LastUpdated date={lastUpdatedDisplay} variant="onDark" as="span" class="!text-base !font-medium !text-white/90" />
              </div>
              <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                <span>{post.readTime}</span>
              </div>
            </div>
              </div>
            </div>
          </div>
        </section>
      )
    }

    <main class="pt-4 pb-8">
      <div class="article-editorial">
        <ArticleTocRail items={tocItems} pathwayToc={articlePathway.toc}>
          <ArticleSideRail
            slot="rail"
            related={railRelated}
            subheadline={articlePathway.form.subheadline}
            buttonLabel={articlePathway.form.buttonLabel}
          />
          <nav aria-label="Breadcrumb" class="py-4 mb-6">
            <ol class="flex flex-wrap items-center gap-0 text-sm">
              <li class="flex items-center">
                <a href="/" class="text-muted-foreground/70 hover:text-foreground transition-colors font-medium tracking-wide uppercase text-[11px]">
                  Home
                </a>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3 mx-2 text-muted-foreground/30" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
              </li>
              <li class="flex items-center">
                <a href="/research" class="text-muted-foreground/70 hover:text-foreground transition-colors font-medium tracking-wide uppercase text-[11px] inline-flex items-center gap-1.5">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3" aria-hidden="true"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
                  Research
                </a>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3 mx-2 text-muted-foreground/30" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
              </li>
              <li class="flex items-center">
                <span class="text-foreground font-serif text-base font-semibold">{post.title}</span>
              </li>
            </ol>
          </nav>

          <div data-article-follow-inline>
            <div data-article-follow>
              <PreferredSourcesCTA />
            </div>
          </div>

          {
            inlineHero && (
              <header class="mb-8">
                <div class="flex flex-wrap items-center gap-4 mb-4">
                  <div class="editorial-kicker">
                    {post.category}
                  </div>
                  <div class="research-article-meta flex items-center gap-2 text-muted-foreground font-medium">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5" aria-hidden="true"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
                    <span>Published <time datetime={datePublishedIso}>{post.date}</time></span>
                  </div>
                  <div class="research-article-meta flex items-center gap-2 text-muted-foreground font-medium">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5" aria-hidden="true"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
                    <LastUpdated date={lastUpdatedDisplay} as="span" class="!text-base !font-medium" />
                  </div>
                  <div class="research-article-meta flex items-center gap-2 text-muted-foreground font-medium">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    <span>{post.readTime}</span>
                  </div>
                </div>

                <h1 class="research-article-title mb-6 text-left">
                  {post.title}
                </h1>

                <div class="aspect-video overflow-hidden rounded-lg mb-8">
                  <img
                    src={inlineHero.src}
                    srcset={inlineHero.srcset}
                    sizes={inlineHero.sizes}
                    alt={post.imageAlt}
                    title={post.title}
                    width={inlineHero.width}
                    height={inlineHero.height}
                    class="w-full h-full object-cover"
                    loading="eager"
                    decoding="sync"
                    fetchpriority="high"
                  />
                </div>
              </header>
            )
          }

          <ArticleContents items={tocItems} pathwayToc={articlePathway.toc} />

          <article>
            <LegalDisclaimer className="mb-8 article-legal-disclaimer" />
            {
              isGraceCalculator && (
                <div class="article-content">
                  <h2>What you can do in the 60 days</h2>
                  <p>
                    <a href={USCIS_TERMINATION_OPTIONS_URL}>{USCIS_TERMINATION_LINK_LABEL}</a>
                    {' '}states: {USCIS_TERMINATION_PAGE_ARCHIVED} USCIS describes these options on that page:
                  </p>
                  <ul>
                    {USCIS_POST_TERMINATION_OPTIONS.map((option) => (
                      <li>{option}</li>
                    ))}
                  </ul>
                  <p>{USCIS_H1B_NEW_PETITION}</p>
                  <p>
                    {USCIS_EB5_ADJUSTMENT}{' '}
                    <a href="/pathways/eb5-concurrent-filing">EB-5 concurrent filing</a>
                    {' '}and the{' '}
                    <a href="/pathways/h1b-to-green-card">H-1B to green card pathway</a>
                    {' '}describe that EB-5 filing on this site.
                  </p>
                </div>
              )
            }
            {summaryHtml && <ArticleSummary html={summaryHtml} />}
            {
              showPostIntroCta ? (
                <>
                  {introRemainderHtml && <div class="article-content" set:html={introRemainderHtml} />}
                  {renderPostIntroCta && <PostIntroCTA postIntro={articlePathway.postIntro} />}
                  <div class="article-content" set:html={firstHalfHtml} />
                </>
              ) : (
                <div class="article-content" set:html={firstHalfHtml} />
              )
            }
            {showMidSplit && (
              <MidArticleCTA
                client:visible
                mid={articlePathway.mid}
                pathwayContext={articlePathway.form.pathwayContext}
              />
            )}
            {secondHalfHtml && <div class="article-content" set:html={secondHalfHtml} />}
            {
              isGraceCalculator && (
                <div class="article-content">
                  <h2>Grace period questions</h2>
                  {GRACE_PERIOD_FAQS.map((item) => (
                    <div>
                      <h3>{item.question}</h3>
                      <p>{item.answer}</p>
                    </div>
                  ))}
                </div>
              )
            }
          </article>

          <div class="mt-12 p-6 bg-muted/50 border border-border rounded-lg">
            <p class="article-bottom-disclaimer text-muted-foreground leading-relaxed m-0">
              <strong class="text-foreground">Disclaimer:</strong> The opinions expressed on this website are solely those of the author/presenter. The information provided is for general informational purposes only and should not be considered professional or legal advice. Student EB5 and its contributors do not endorse or take responsibility for any actions taken based on the information presented here. Visitors are strongly advised to consult with qualified immigration attorneys and financial advisors before making any EB-5 investment decisions or taking any actions based on the content on this website.
            </p>
          </div>

          <ShareButtons
            client:visible
            url={pageCanonical}
            title={post.title}
            excerpt={post.excerpt}
          />

          <footer class="mt-12 pt-8 border-t">
            <div class="flex items-center justify-between">
              <div class="article-footer-meta text-muted-foreground">
                Published <time datetime={datePublishedIso}>{post.date}</time>
                {` · Last updated: ${lastUpdatedDisplay}`}
              </div>
              <a
                href="/contact"
                class="inline-flex items-center px-4 py-2 bg-primary text-primary-foreground rounded-md hover:bg-primary/90 transition-colors"
              >
                Learn More
              </a>
            </div>
          </footer>

          <PagePhotoCredits pathname={`/research/${slug}`} />

          <section class="mt-16 pt-8 border-t">
            <h2 class="editorial-h2 mb-8 mt-0">Related Articles</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              {
                relatedPosts.map((relatedPost) => (
                  <RelatedResearchCard
                    variant="article"
                    item={{
                      title: relatedPost.title,
                      url: `/research/${relatedPost.slug}`,
                    }}
                    image={relatedPost.image}
                    imageAlt={relatedPost.imageAlt}
                    category={relatedPost.category}
                    date={relatedPost.date}
                    readTime={relatedPost.readTime}
                  />
                ))
              }
            </div>
          </section>
        </ArticleTocRail>
      </div>
    </main>
    <ConsultationCTA
      client:visible
      articleForm
      headline={articlePathway.form.headline}
      subheadline={articlePathway.form.subheadline}
      buttonLabel={articlePathway.form.buttonLabel}
      pathwayContext={articlePathway.form.pathwayContext}
    />
    <ArticleEmailContact />
    <SiteFooter />
  </div>
  <Toaster client:idle />
</Layout>
