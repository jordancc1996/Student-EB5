---
import Layout from '../../layouts/Layout.astro';
import Header from '@/components/Header';
import SiteFooter from '@/components/SiteFooter.astro';
import PreferredSourcesCTA from '@/components/PreferredSourcesCTA.astro';
import Breadcrumb from '@/components/Breadcrumb';
import LegalDisclaimer from '@/components/LegalDisclaimer.astro';
import OptimizedImage from '@/components/OptimizedImage.astro';
import FaqListing from '@/components/FaqListing';
import JourneyCTA from '@/components/JourneyCTA.astro';
import { ConsultationCTA } from '@/components/ConsultationCTA';
import { Toaster } from '@/components/ui/toaster';
import { getCollection } from 'astro:content';
import faqHero from '@/assets/faq-hero.jpg';
import faqHeroWebp from '@/assets/faq-hero.webp';
import { SITE_CONFIG } from '@/lib/seo/config';
import { generateFAQSchema } from '@/lib/seo/structured-data';

const faqEntries = await getCollection('faq');

const faqListingItems = faqEntries.map((entry) => ({
  id: entry.data.id,
  slug: entry.data.slug,
  question: entry.data.question,
  answer: entry.body ?? '',
  category: entry.data.category,
  keywords: entry.data.keywords,
}));

const faqSchemaItems = faqEntries.map((entry) => ({
  question: entry.data.question,
  answer: (entry.body ?? '').replace(/<[^>]*>/g, ''),
}));

const title = 'EB-5 Investor FAQ - Timelines, Fees and Filing';
const description =
  'EB-5 investor FAQ answers cover concurrent filing, $800,000 TEA investment, rural set-asides, gifted funds, and H-1B grace period options for families.';
const pageCanonical = `${SITE_CONFIG.url}/faq`;
const ogTitle = `${title} | StudentEB5`;
const ogDescription = description;
const ogImage = `${SITE_CONFIG.url}/og-image.jpg`;
const keywords = [
  'EB-5 investor FAQ',
  'EB-5 FAQ concurrent filing',
  'EB-5 gifted funds FAQ',
  'EB-5 timeline FAQ',
];

const structuredData = generateFAQSchema(faqSchemaItems);
---

<Layout>
  <Fragment slot="head">
    <title>{title} | StudentEB5</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <link rel="canonical" href={pageCanonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/https:\/\/www\.studenteb5\.com/g, SITE_CONFIG.url)} />
  </Fragment>

  <div class="min-h-screen bg-background">
    <Header client:load />

    <section class="relative h-[70vh] min-h-[500px] flex items-center justify-center -mt-[120px] pt-[120px]">
      <div class="absolute inset-0">
        <OptimizedImage
          src={faqHero}
          webpSrc={faqHeroWebp}
          alt="San Francisco downtown and Ferry Building at sunset representing opportunity"
          className="w-full h-full object-cover"
          loading="eager"
          fetchPriority="high"
          sizes="100vw"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-black/30 via-black/40 to-black/60"></div>
      </div>
      <div class="relative z-10 container mx-auto px-6 text-center text-white">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-serif font-bold mb-6 max-w-4xl mx-auto leading-tight">
          EB-5 Investor FAQ - Timelines Fees Concurrent Filing and Gifts
        </h1>
        <p class="text-lg md:text-xl text-white/90 max-w-3xl mx-auto leading-relaxed">
          EB-5 investor FAQ topics include the $800,000 TEA threshold, concurrent filing EADs, gifted funds, and the
          Sept 30, 2026 grandfathering deadline. For deeper analysis, see our{' '}
          <a href="/research/eb5-comprehensive-faq-timeline-international-students" class="text-white underline underline-offset-4 hover:text-white/90">EB-5 FAQ and timeline for international students</a>
          {' '}and the{' '}
          <a href="/research/complete-2027-eb5-guide" class="text-white underline underline-offset-4 hover:text-white/90">complete 2027 EB-5 guide</a>.
        </p>
      </div>
    </section>

    <PreferredSourcesCTA />

    <main class="container mx-auto px-6 pt-4 pb-8">
      <Breadcrumb client:load initialPathname="/faq" />
      <LegalDisclaimer className="max-w-6xl mx-auto mb-6" />
      <FaqListing client:only="react" faqs={faqListingItems} />
    </main>

    <ConsultationCTA client:visible />
    <JourneyCTA />
    <SiteFooter />
    <Toaster client:load />
  </div>
</Layout>
